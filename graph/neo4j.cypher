MERGE (n:Node {id: "doc_docs_docs_intro_mdx"}) SET n += {"id": "doc_docs_docs_intro_mdx", "type": "document", "label": "Porto Documentation", "description": "--- id: intro title: Porto Docs slug: / sidebarposition: 0 --- Porto Docs Porto is decentralized streaming infrastructure that replaces platform-owned delivery and settlement with a network run by artists, labels, publishers, and independent node operators. This site has two sections, both pulled directly from their source-of-truth repos at build time , nothing here is hand-copied: - [Whitepaper](/whitepaper) , the.", "source_path": "docs/docs/intro.mdx", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "published", "materialized": true, "source_hash": "sha256:c4bcf9410d7a23dc996d971ca8f4a18800266152e81e61c6740663881e64d1b8", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
