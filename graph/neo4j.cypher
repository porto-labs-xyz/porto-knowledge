MERGE (n:Node {id: "route_design-change"}) SET n += {"id": "route_design-change", "type": "agent_route", "label": "Design change", "description": "Use released package content and record an approved design decision. Do not materialise restricted visual sources."};
MERGE (n:Node {id: "route_player-prototype"}) SET n += {"id": "route_player-prototype", "type": "agent_route", "label": "Player prototype", "description": "Traverse implementation and style sources, read their cited sections, and distinguish simulated behaviour from protocol evidence. Enrich source text and meaningful typed links after changes; verify both graphs and review impacts."};
MERGE (n:Node {id: "route_london-implementation"}) SET n += {"id": "route_london-implementation", "type": "agent_route", "label": "London 0.1.0 approved implementation", "description": "Current agreed direction is Move accounting/payouts, S3 audio and one streaming-node role. Start with the storage spike. The RocksDB-first and hash-only commitment designs are superseded; detailed chapters await coordinated revision. Do not claim production scalability from local collection tests."};
MERGE (n:Node {id: "route_london-ledger"}) SET n += {"id": "route_london-ledger", "type": "agent_route", "label": "London Move accounting and storage research", "description": "Current agreed direction is Move accounting/payouts, S3 audio and one streaming-node role. Start with the storage spike. The RocksDB-first and hash-only commitment designs are superseded; detailed chapters await coordinated revision. Do not claim production scalability from local collection tests."};
