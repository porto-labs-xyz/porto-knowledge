MERGE (n:Node {id: "doc_docs_london_0_1_0_glossary_md"}) SET n += {"id": "doc_docs_london_0_1_0_glossary_md", "type": "document", "label": "London APPROVED: Glossary", "description": "--- id: glossary title: \"Glossary\" sidebarposition: 90 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Term London meaning ------ Approved specification Product-owner-authorised implementation baseline; not runtime or launch evidence Independent operator Participant controlling the host/account and operating decision Peer fill Authorised node-to-node content transfer; earns no listening reward Delivery.", "source_path": "docs/london-0.1.0/glossary.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:471b42c631f5b771c3860231f72d33bfecfaa9604e13b79b63f492752359f61a", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_index_mdx"}) SET n += {"id": "doc_docs_london_0_1_0_index_mdx", "type": "document", "label": "London APPROVED: London 0.1.0", "description": "--- id: index title: \"London 0.1.0\" sidebarposition: 0 sidebarlabel: \"Start here (Approved)\" slug: /overview --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 London is approved for implementation as a bounded real-money music and infrastructure pilot. A listener pays, an independently operated node serves licensed music, Porto records and commits the evidence, and artists and operators receive explainable.", "source_path": "docs/london-0.1.0/index.mdx", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:c78e14f287c46af5e6970ce5ec4aad6ab75bfd237fa5f9f54782c13953825dd6", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_openapi_json"}) SET n += {"id": "doc_docs_london_0_1_0_openapi_json", "type": "document", "label": "London APPROVED: openapi", "description": "{ \"openapi\": \"3.1.0\", \"info\": { \"title\": \"Porto London 0.1.0 approved MVP contracts\", \"version\": \"0.1.0\", \"description\": \"Approved implementation specification. Synthetic examples are structural, not valid signatures or real funds. Provider-specific webhook transport is defined by the selected adapter, not a universal invented API.\" }, \"servers\": [ { \"url\": \"https://coordinator.example.invalid\", \"description\":.", "source_path": "docs/london-0.1.0/openapi.json", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:a5706c8b503fd03a76d89af94b306756e466ba9846b39a8c1f2c04c2ecdb14af", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_release_profile_schema_json"}) SET n += {"id": "doc_docs_london_0_1_0_release_profile_schema_json", "type": "document", "label": "London APPROVED: release-profile.schema", "description": "{ \"$schema\": \"https://json-schema.org/draft/2020-12/schema\", \"title\": \"London production release profile\", \"description\": \"Additionally enforce bps sum 10000, caps recipient <= run <= pilot, approved providers/pins, and independent RPC configuration. Schema shape is not launch approval.\", \"type\": \"object\", \"additionalProperties\": false, \"required\": [ \"schemaversion\", \"environment\", \"releaseid\", \"effectiveat\",.", "source_path": "docs/london-0.1.0/release-profile.schema.json", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:c33acc660653de9503a6dc4192c5858c4d6d9594f98c441f9ed2afcddb1d136e", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
