MERGE (n:Node {id: "route_london-implementation"}) SET n += {"id": "route_london-implementation", "type": "agent_route", "label": "London 0.1.0 draft implementation", "description": "Read London as DRAFT PROPOSED IMPLEMENTATION SPECIFICATION. Verify canonical contrasts and open decisions. Do not treat proposal text as current implementation or approved economics. No publication without explicit permission."};
