MERGE (n:Node {id: "doc_docs_research_london_move_storage_readme_md"}) SET n += {"id": "doc_docs_research_london_move_storage_readme_md", "type": "document", "label": "London Move storage spike (research)", "description": "London Move storage spike 22 September 2026. RESEARCH FINDINGS, NOT A PRODUCTION CONTRACT OR SCALE CERTIFICATION. Decision and scope The product owner agreed to a smaller London architecture: S3 audio, one streaming-node role, a small coordinator and Move-owned accounting/payout state. Artist ownership is an operator attribute, not a node type. This direction supersedes the preceding RocksDB-first implementation.", "source_path": "docs/research/london-move-storage/README.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "research", "materialized": true, "source_hash": "sha256:20ba9a4709d9360f0cf293854a2f4820b7aa9611a3373dab7213f6f8f37e1785", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
