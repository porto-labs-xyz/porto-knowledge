MERGE (n:Node {id: "concept_player_prototype"}) SET n += {"id": "concept_player_prototype", "type": "concept", "label": "Record-led player prototype", "description": "A static listening room with fictional records, unfolding sleeves, browser-local collections and freely selectable album tracks. Simulated ownership and node indicators do not establish live network activity.", "aliases": ["player prototype", "listening room", "vinyl shelf", "album navigation"], "authority": "source_grounded", "temporal_scope": "verify_source", "source_details": [{"source_path": "listening-app/README.md", "heading": "Current behaviour", "source_hash": null, "source_revision": "d6f2f0045a404f8be041bbb2e8f805eeddc2e8e1", "authority": "prototype_implementation", "availability": "restricted_metadata_only"}, {"source_path": "listening-app/README.md", "heading": "Evidence and rights", "source_hash": null, "source_revision": "d6f2f0045a404f8be041bbb2e8f805eeddc2e8e1", "authority": "prototype_implementation", "availability": "restricted_metadata_only"}, {"source_path": "listening-app/docs/ARCHITECTURE.md", "heading": "Playback", "source_hash": null, "source_revision": "d6f2f0045a404f8be041bbb2e8f805eeddc2e8e1", "authority": "prototype_implementation", "availability": "restricted_metadata_only"}, {"source_path": "listening-app/docs/ARCHITECTURE.md", "heading": "Evidence limits", "source_hash": null, "source_revision": "d6f2f0045a404f8be041bbb2e8f805eeddc2e8e1", "authority": "prototype_implementation", "availability": "restricted_metadata_only"}]};
MERGE (n:Node {id: "concept_player_style"}) SET n += {"id": "concept_player_style", "type": "concept", "label": "Architectural player style", "description": "Matte varied-width record spines, a fine baseline, paper and charcoal typography, unfolding sleeves and spare transport controls extend the shared Porto foundations for the player.", "aliases": ["player style guide", "record spines", "gatefold", "transport icons"], "authority": "source_grounded", "temporal_scope": "verify_source", "source_details": [{"source_path": "porto-design-system/STYLEGUIDE.md", "heading": "Record shelf", "source_hash": null, "source_revision": "1f4b7a58bbee1fbe1b8b5d4726270947d355aa80", "authority": "released_design_system", "availability": "restricted_metadata_only"}, {"source_path": "porto-design-system/STYLEGUIDE.md", "heading": "Sleeve and artwork", "source_hash": null, "source_revision": "1f4b7a58bbee1fbe1b8b5d4726270947d355aa80", "authority": "released_design_system", "availability": "restricted_metadata_only"}, {"source_path": "porto-design-system/STYLEGUIDE.md", "heading": "Track navigation and transport", "source_hash": null, "source_revision": "1f4b7a58bbee1fbe1b8b5d4726270947d355aa80", "authority": "released_design_system", "availability": "restricted_metadata_only"}, {"source_path": "listening-app/docs/DESIGN_SYSTEM.md", "heading": "Token mapping", "source_hash": null, "source_revision": "d6f2f0045a404f8be041bbb2e8f805eeddc2e8e1", "authority": "prototype_implementation", "availability": "restricted_metadata_only"}]};
