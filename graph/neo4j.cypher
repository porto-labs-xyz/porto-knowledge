MERGE (n:Node {id: "doc_docs_readme_md"}) SET n += {"id": "doc_docs_readme_md", "type": "document", "label": "Documentation build guidance", "description": "Porto Docs Source for [docs.portolabs.xyz](https://docs.portolabs.xyz), built with [Docusaurus](https://docusaurus.io). The London 0.1.0 approved implementation specification is maintained in london-0.1.0/ and included in the current site build at /london-0.1.0/overview. It is approved for implementation of the bounded peer-delivery MVP. Approval does not imply deployment, audit completion or real-money launch.", "source_path": "docs/README.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:489980667e5bdaecf24c03a2bdc43207c9493be670fee604352eacf8ad2de227", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_docs_intro_mdx"}) SET n += {"id": "doc_docs_docs_intro_mdx", "type": "document", "label": "Porto Documentation", "description": "--- id: intro title: Porto Docs slug: / sidebarposition: 0 --- Porto Docs Porto is decentralized streaming infrastructure that replaces platform-owned delivery and settlement with a network run by artists, labels, publishers, and independent node operators. This site has two sections, both pulled directly from their source-of-truth repos at build time , nothing here is hand-copied: - [Whitepaper](/whitepaper) , the.", "source_path": "docs/docs/intro.mdx", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "published", "materialized": true, "source_hash": "sha256:c4bcf9410d7a23dc996d971ca8f4a18800266152e81e61c6740663881e64d1b8", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_00_status_and_scope_md"}) SET n += {"id": "doc_docs_london_0_1_0_00_status_and_scope_md", "type": "document", "label": "London APPROVED: Status, approval and exact scope", "description": "--- id: 00-status-and-scope title: \"Status, approval and exact scope\" sidebarposition: 1 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Approval record The product owner approved this reduced MVP specification on 22 September 2026 in the authoring conversation. This revision replaces the broader London draft introduced by documentation commit fdb5d3f. Approval covers the implementation scope and.", "source_path": "docs/london-0.1.0/00-status-and-scope.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:63ec066ee9a919b6495ae614e974ce2586de6ff8d33caaef19186286aad7716d", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_01_executive_architecture_md"}) SET n += {"id": "doc_docs_london_0_1_0_01_executive_architecture_md", "type": "document", "label": "London APPROVED: Executive architecture", "description": "--- id: 01-executive-architecture title: \"Executive architecture\" sidebarposition: 2 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Approved architecture London is a deliberately small music delivery and accounting network. Porto runs the catalogue, subscriptions, routing, accounting and payout coordination. Artists and other invited parties operate delivery nodes on infrastructure they control. Aptos.", "source_path": "docs/london-0.1.0/01-executive-architecture.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:269bf706ed236e637ef728762aa910593f1fb21be2ed7614bc04027420d85f35", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_02_system_architecture_md"}) SET n += {"id": "doc_docs_london_0_1_0_02_system_architecture_md", "type": "document", "label": "London APPROVED: System architecture and ownership", "description": "--- id: 02-system-architecture title: \"System architecture and ownership\" sidebarposition: 3 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Deployment boundaries The web application calls Porto over HTTPS. Porto owns a modular API and job worker codebase, a relational ledger, private S3 origin in London, and separately permissioned evidence storage. Each participant owns its node host, local cache, node.", "source_path": "docs/london-0.1.0/02-system-architecture.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:1615d9788750314eccd9b96e747e55c55230f1f7bd617b91ee24f6cd4e8be98b", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_03_roles_and_trust_model_md"}) SET n += {"id": "doc_docs_london_0_1_0_03_roles_and_trust_model_md", "type": "document", "label": "London APPROVED: Roles and trust model", "description": "--- id: 03-roles-and-trust-model title: \"Roles and trust model\" sidebarposition: 4 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Roles Principal Allowed actions Forbidden actions --------- Listener Pay, see own access status, create/close own session, request authorised chunks Supply settlement-critical duration, access other accounts Artist / rights recipient Read own works, allocations, statements and.", "source_path": "docs/london-0.1.0/03-roles-and-trust-model.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:4e1f0a42426e07a26357116ddb1ce9c159c1decaa15d69735c96eba9a58e8556", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_04_listener_and_artist_journeys_md"}) SET n += {"id": "doc_docs_london_0_1_0_04_listener_and_artist_journeys_md", "type": "document", "label": "London APPROVED: Listener, artist and operator journeys", "description": "--- id: 04-listener-and-artist-journeys title: \"Listener, artist and operator journeys\" sidebarposition: 5 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Listener The listener sees a curated catalogue, plan price and billing terms, signs in, and uses hosted checkout. The returning browser shows \u201cConfirming payment\u201d until a verified provider event creates entitlement. A failed or pending payment must not.", "source_path": "docs/london-0.1.0/04-listener-and-artist-journeys.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:a339dc1e5a05334706b78687e0e21fc1820d2fbd3902f1d7d7d8f54ac2c2135d", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_05_catalogue_rights_and_content_md"}) SET n += {"id": "doc_docs_london_0_1_0_05_catalogue_rights_and_content_md", "type": "document", "label": "London APPROVED: Catalogue, rights and content", "description": "--- id: 05-catalogue-rights-and-content title: \"Catalogue, rights and content\" sidebarposition: 6 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Manual catalogue contract An administrator imports a versioned catalogue document with workid, title, display artist, duration in integer milliseconds, licence reference, allowed territories, availability interval, rightsversion, recipients with integer basis.", "source_path": "docs/london-0.1.0/05-catalogue-rights-and-content.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:aad7d3d4afe51391f51d98d744567338456710f0f33b3c3023fdd3e882cf007d", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_06_streaming_delivery_and_attestation_md"}) SET n += {"id": "doc_docs_london_0_1_0_06_streaming_delivery_and_attestation_md", "type": "document", "label": "London APPROVED: Playback, peer delivery and usage evidence", "description": "--- id: 06-streaming-delivery-and-attestation title: \"Playback, peer delivery and usage evidence\" sidebarposition: 7 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Playback authorisation The coordinator checks authenticated entitlement, territory, active work/rights and one active session per listener. A second session request returns 409 ACTIVESESSION; the listener may explicitly close the old session.", "source_path": "docs/london-0.1.0/06-streaming-delivery-and-attestation.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:b59e533c6bd349b13ab42c89d65e6962c675c8eb3273a0f917ef3c009009af39", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_07_fraud_controls_and_disputes_md"}) SET n += {"id": "doc_docs_london_0_1_0_07_fraud_controls_and_disputes_md", "type": "document", "label": "London APPROVED: Basic integrity controls and manual exceptions", "description": "--- id: 07-fraud-controls-and-disputes title: \"Basic integrity controls and manual exceptions\" sidebarposition: 8 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Small control set This MVP implements deterministic validation, duplicate prevention, rate limits, suspension and manual payout holds. It does not implement a fraud scoring engine, operator reputation market, case-management dashboard,.", "source_path": "docs/london-0.1.0/07-fraud-controls-and-disputes.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:4407f2b7c556fe0da9f7b13fc84ac29508b0f1907fca34b6aebbed7393f4ca2b", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_08_usdc_treasury_and_settlement_md"}) SET n += {"id": "doc_docs_london_0_1_0_08_usdc_treasury_and_settlement_md", "type": "document", "label": "London APPROVED: Funding, accounting and real payouts", "description": "--- id: 08-usdc-treasury-and-settlement title: \"Funding, accounting and real payouts\" sidebarposition: 9 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Money states and ownership GBP subscriptions are Porto company revenue. Listeners purchase access, receive no USDC balance and own no treasury crypto. A selected provider clears payments; Porto converts approved net revenue in batches to native Aptos.", "source_path": "docs/london-0.1.0/08-usdc-treasury-and-settlement.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:2343ff0866e56e05bc3b069a7a4cabbb64948b6f0f11cae65a200e0207c46485", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_09_move_contract_specification_md"}) SET n += {"id": "doc_docs_london_0_1_0_09_move_contract_specification_md", "type": "document", "label": "London APPROVED: One append-only commitment contract", "description": "--- id: 09-move-contract-specification title: \"One append-only commitment contract\" sidebarposition: 10 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Scope Implement exactly one custom module, londoncommitments. It stores artifact digests and links, accepts no USDC, calculates no royalties and executes no payouts. Work/operator registries, claim proofs, reserve contracts and on-chain fraud state are.", "source_path": "docs/london-0.1.0/09-move-contract-specification.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:a434822add49b50ece00f9e178e2662cbd151e859a66fe473ca43254439a9036", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_10_off_chain_services_and_apis_md"}) SET n += {"id": "doc_docs_london_0_1_0_10_off_chain_services_and_apis_md", "type": "document", "label": "London APPROVED: Backend modules, APIs and provider boundaries", "description": "--- id: 10-off-chain-services-and-apis title: \"Backend modules, APIs and provider boundaries\" sidebarposition: 11 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 One backend, restricted jobs Build a modular backend and transactional worker system. PostgreSQL is authoritative for entitlements, grant consumption, evidence decisions, budgets and obligations. Object storage retains exact signed/canonical.", "source_path": "docs/london-0.1.0/10-off-chain-services-and-apis.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:5ee235043b52b4f20db946e50a596125662dc2c30516a7bfcf964f8f85f2be33", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_11_data_model_and_event_schemas_md"}) SET n += {"id": "doc_docs_london_0_1_0_11_data_model_and_event_schemas_md", "type": "document", "label": "London APPROVED: Data model, state machines and ledger", "description": "--- id: 11-data-model-and-event-schemas title: \"Data model, state machines and ledger\" sidebarposition: 12 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Persistence conventions Use UUIDv4 primary IDs, UTC timestamps and integer amounts. Numeric wire values larger than safe JavaScript integers are decimal strings. PostgreSQL numeric(20,0) holds unsigned u64 amounts; add nonnegative and maximum checks..", "source_path": "docs/london-0.1.0/11-data-model-and-event-schemas.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:1b9c8b34fbc96095a08e1dc9127d329d957e37c5d76cb7dd04bb3318e58efcc7", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_12_security_privacy_and_key_management_md"}) SET n += {"id": "doc_docs_london_0_1_0_12_security_privacy_and_key_management_md", "type": "document", "label": "London APPROVED: Security, privacy and key management", "description": "--- id: 12-security-privacy-and-key-management title: \"Security, privacy and key management\" sidebarposition: 13 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Minimum security boundary All internet endpoints require TLS. Browser actions require account ownership and CSRF protection; node API tokens bind one node and cannot authorise finance. The gateway verifies entitlement on grant issuance and.", "source_path": "docs/london-0.1.0/12-security-privacy-and-key-management.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:d9f7f51c6e87749a8f2235b458d4c9f064095a8ea0d66732011f4ef36c3d01f1", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_13_operations_observability_and_incidents_md"}) SET n += {"id": "doc_docs_london_0_1_0_13_operations_observability_and_incidents_md", "type": "document", "label": "London APPROVED: Operations, recovery and incidents", "description": "--- id: 13-operations-observability-and-incidents title: \"Operations, recovery and incidents\" sidebarposition: 14 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Environments Local uses fixture identity/billing, object-storage emulator, local database and Aptos localnet/testnet. Staging uses separate provider sandbox accounts, buckets, keys, database and testnet assets with persistent visible TEST labels..", "source_path": "docs/london-0.1.0/13-operations-observability-and-incidents.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:664fbaea7f2fee1aa7f575df42ac8d1cd576ccdc0e5b2c03b76e852da98c9a07", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_14_testing_and_launch_gates_md"}) SET n += {"id": "doc_docs_london_0_1_0_14_testing_and_launch_gates_md", "type": "document", "label": "London APPROVED: Testing, proof levels and launch gates", "description": "--- id: 14-testing-and-launch-gates title: \"Testing, proof levels and launch gates\" sidebarposition: 15 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Evidence levels Use SPECIFICATION for these approved requirements; FIXTURE PASS for synthetic tests; STAGING VERIFIED for deployed sandbox behaviour; MAINNET VERIFIED for confirmed real-chain operations; PILOT OBSERVED for actual paid listening and.", "source_path": "docs/london-0.1.0/14-testing-and-launch-gates.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:6050b0853549fee7624d9c948091a4241ef3c1e0620845fa946c932d7664924b", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_15_migration_to_porto_app_chain_md"}) SET n += {"id": "doc_docs_london_0_1_0_15_migration_to_porto_app_chain_md", "type": "document", "label": "London APPROVED: Future compatibility, no migration implementation", "description": "--- id: 15-migration-to-porto-app-chain title: \"Future compatibility, no migration implementation\" sidebarposition: 16 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Out of scope London does not build a Porto app-chain, bridge, validator stack, token, snapshot-claim contract or migration service. No delivery operator automatically becomes an attestor or validator. These are distinct responsibilities.", "source_path": "docs/london-0.1.0/15-migration-to-porto-app-chain.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:a6b3e3934bced23b52e27af0ab519d8402518811b9473a9a15c61f7d7da40a8c", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_16_implementation_plan_md"}) SET n += {"id": "doc_docs_london_0_1_0_16_implementation_plan_md", "type": "document", "label": "London APPROVED: Implementation plan and agent handoff", "description": "--- id: 16-implementation-plan title: \"Implementation plan and agent handoff\" sidebarposition: 17 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Agent entry contract Read status/scope, architecture, the domain chapter for your work, OpenAPI, wire contracts, configuration and acceptance cases before implementation. Treat this directory as the approved London specification. Do not implement removed.", "source_path": "docs/london-0.1.0/16-implementation-plan.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:3330369ee10c14610d7fd0cc0b46f78c5b42b667131e4e8253c34674ba8ccc0d", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_17_open_decisions_and_risk_register_md"}) SET n += {"id": "doc_docs_london_0_1_0_17_open_decisions_and_risk_register_md", "type": "document", "label": "London APPROVED: Required launch inputs and residual risks", "description": "--- id: 17-open-decisions-and-risk-register title: \"Required launch inputs and residual risks\" sidebarposition: 18 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Architecture is approved The product owner has approved the reduced scope. There is no open decision about whether to build peer delivery, a separate attestation service or six settlement modules: peer delivery is required, the latter two are.", "source_path": "docs/london-0.1.0/17-open-decisions-and-risk-register.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:e5c846d4259ec33b0b886814a31d15e827c336f9ec93348732e6bbab3e4e04f8", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_18_compatibility_with_existing_pips_md"}) SET n += {"id": "doc_docs_london_0_1_0_18_compatibility_with_existing_pips_md", "type": "document", "label": "London APPROVED: Compatibility with existing Porto sources", "description": "--- id: 18-compatibility-with-existing-pips title: \"Compatibility with existing Porto sources\" sidebarposition: 19 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Status APPROVED FOR LONDON 0.1.0 describes this implementation baseline. CURRENT SOURCE describes the unchanged whitepaper/PIPs, which retain their own status and scope. London does not globally amend those sources. Their historical Beta/Mainnet.", "source_path": "docs/london-0.1.0/18-compatibility-with-existing-pips.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:4f04f86376b1c53b3f3a8f456652f10c474717ada5d514ef817240ab6d647a9e", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_19_architecture_decisions_md"}) SET n += {"id": "doc_docs_london_0_1_0_19_architecture_decisions_md", "type": "document", "label": "London APPROVED: Architecture decision records", "description": "--- id: 19-architecture-decisions title: \"Architecture decision records\" sidebarposition: 20 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Accepted decisions All ADRs below are APPROVED as part of this specification on 22 September 2026. They replace conflicting choices in the earlier London draft. ADR Decision Reason and consequence --------- ADR-01 Aptos Mainnet with native USDC; no PRT or new chain.", "source_path": "docs/london-0.1.0/19-architecture-decisions.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:2f58277bc1b5e1d6277c66fe6f1d25e48c97cddcf581f9fb5e034e8f6fe3873b", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_20_api_contracts_md"}) SET n += {"id": "doc_docs_london_0_1_0_20_api_contracts_md", "type": "document", "label": "London APPROVED: API contracts and endpoint catalogue", "description": "--- id: 20-api-contracts title: \"API contracts and endpoint catalogue\" sidebarposition: 21 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Contract authority [OpenAPI](openapi.json) is the exhaustive coordinator and node HTTP surface for this release. It includes closed request/response schemas, examples, authentication, ownership, rate limits, error envelopes, audit-event names and idempotency rules..", "source_path": "docs/london-0.1.0/20-api-contracts.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:f68b21e425247915e6bfa64be34517b130fa209e5be54575ece535c02b4ae5c7", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_21_wire_and_commitment_contracts_md"}) SET n += {"id": "doc_docs_london_0_1_0_21_wire_and_commitment_contracts_md", "type": "document", "label": "London APPROVED: Canonical wire formats, artifacts and verification", "description": "--- id: 21-wire-and-commitment-contracts title: \"Canonical wire formats, artifacts and verification\" sidebarposition: 22 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Primitive encoding Schema identifier is london.v1. Internal IDs are lowercase UUIDv4 strings; all cryptographic hashes are 64 lowercase hexadecimal characters. Aptos addresses are 0x plus 64 lowercase hex digits. Integer wire quantities.", "source_path": "docs/london-0.1.0/21-wire-and-commitment-contracts.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:03c6f670860ccdd1bc3638cd2e2e9392dccfbc4c21bc6c15c92f644d72ad398a", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_22_acceptance_test_catalogue_md"}) SET n += {"id": "doc_docs_london_0_1_0_22_acceptance_test_catalogue_md", "type": "document", "label": "London APPROVED: Acceptance test catalogue", "description": "--- id: 22-acceptance-test-catalogue title: \"Acceptance test catalogue\" sidebarposition: 23 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Execution contract Every case below must have automated coverage where deterministic, or a retained observation/sign-off artifact where it concerns real participants. Record environment, commit/image/profile hashes, input fixtures, observed result, proof level and.", "source_path": "docs/london-0.1.0/22-acceptance-test-catalogue.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:4f37179e24c343e0aa3b15c32be894fd90bac408b7b0d95185bc0ed5d148d30a", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_23_source_register_md"}) SET n += {"id": "doc_docs_london_0_1_0_23_source_register_md", "type": "document", "label": "London APPROVED: Source register and authority", "description": "--- id: 23-source-register title: \"Source register and authority\" sidebarposition: 24 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Current source The pinned [source manifest](source-manifest.json) contains exact SHA-256 hashes and repository revisions for the canonical Porto sources reviewed. Those sources describe existing product/protocol intent, not evidence of this MVP running. Source authority:.", "source_path": "docs/london-0.1.0/23-source-register.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:994f9ab0622d28f82845e4b5ed5b583506168b5b8599b96c804a03d6e6322c92", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_24_validation_and_impact_md"}) SET n += {"id": "doc_docs_london_0_1_0_24_validation_and_impact_md", "type": "document", "label": "London APPROVED: Documentation validation and impact", "description": "--- id: 24-validation-and-impact title: \"Documentation validation and impact\" sidebarposition: 25 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Evidence boundary This report covers specification artifacts and their documentation build. It does not report application implementation, contract deployment, provider integration, actual streaming, real payments or pilot outcomes. All implementation acceptance.", "source_path": "docs/london-0.1.0/24-validation-and-impact.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:c6dc8c2f09b3f70d5c6f56dd86f5b4b3f41677d776c3e14b3d07109ee1c9287a", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_25_node_package_and_pilot_md"}) SET n += {"id": "doc_docs_london_0_1_0_25_node_package_and_pilot_md", "type": "document", "label": "London APPROVED: Node package and participation pilot", "description": "--- id: 25-node-package-and-pilot title: \"Node package and participation pilot\" sidebarposition: 26 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Installable node contract Deliver a versioned container image, example configuration, one-command compose startup, healthcheck, upgrade/rollback instructions and uninstall procedure. Target Linux amd64 and arm64 hosts with outbound HTTPS and a public inbound.", "source_path": "docs/london-0.1.0/25-node-package-and-pilot.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:04fe71dfc1e8e95d5175435c13261ca676239c181964076bdd309a2db64aa08a", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_26_configuration_and_release_profile_md"}) SET n += {"id": "doc_docs_london_0_1_0_26_configuration_and_release_profile_md", "type": "document", "label": "London APPROVED: Configuration and release profile", "description": "--- id: 26-configuration-and-release-profile title: \"Configuration and release profile\" sidebarposition: 27 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Technical constants These are implementation defaults approved for this bounded MVP, not measured service claims. Changing a constant requires versioned configuration, matching tests and a prospective effective time. Core accounting/replay invariants.", "source_path": "docs/london-0.1.0/26-configuration-and-release-profile.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:01de36327ab24fcd7b587e30b96d8cf0438c1e6bf3df00940dfb86f64b348804", "source_revision": "4b7d621ea2797f4654f929f36549a63c32c884fe"};
