MERGE (n:Node {id: "doc_docs_readme_md"}) SET n += {"id": "doc_docs_readme_md", "type": "document", "label": "Documentation build guidance", "description": "Porto Docs Source for [docs.portolabs.xyz](https://docs.portolabs.xyz), built with [Docusaurus](https://docusaurus.io). The London 0.1.0 draft implementation specification is maintained in london-0.1.0/ and included in the current site build at /london-0.1.0/overview. It is a proposal, not an approved or deployed architecture. Existing canonical protocol content is mirrored: docs/whitepaper.md and docs/pips/ are.", "source_path": "docs/README.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:1567b2ef83e45ab44a62930c25219921de8ffc74c95cee7dbf0ab73a6924b832", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_docs_intro_mdx"}) SET n += {"id": "doc_docs_docs_intro_mdx", "type": "document", "label": "Porto Documentation", "description": "--- id: intro title: Porto Docs slug: / sidebarposition: 0 --- Porto Docs Porto is decentralized streaming infrastructure that replaces platform-owned delivery and settlement with a network run by artists, labels, publishers, and independent node operators. This site has two sections, both pulled directly from their source-of-truth repos at build time , nothing here is hand-copied: - [Whitepaper](/whitepaper) , the.", "source_path": "docs/docs/intro.mdx", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "published", "materialized": true, "source_hash": "sha256:c4bcf9410d7a23dc996d971ca8f4a18800266152e81e61c6740663881e64d1b8", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_00_status_and_scope_md"}) SET n += {"id": "doc_docs_london_0_1_0_00_status_and_scope_md", "type": "document", "label": "London DRAFT: Status and scope", "description": "--- id: 00-status-and-scope title: \"Status and scope\" sidebarposition: 1 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Authority and scope This directory is DRAFT, PROPOSED, and an IMPLEMENTATION SPECIFICATION. PROPOSED FOR LONDON 0.1.0 is the default label for all requirements, algorithms, interfaces, diagrams, defaults and acceptance criteria in this directory. MUST means required by this proposal, not.", "source_path": "docs/london-0.1.0/00-status-and-scope.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:d799ddb3adedb8f349a05198ce327cab5cf84f29ec1926052ddafebd0eba2a05", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_01_executive_architecture_md"}) SET n += {"id": "doc_docs_london_0_1_0_01_executive_architecture_md", "type": "document", "label": "London DRAFT: Executive architecture", "description": "--- id: 01-executive-architecture title: \"Executive architecture\" sidebarposition: 2 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Proposed architecture Porto owns the music experience, catalogue, private origin, delivery admission, fraud decisions and settlement application. Aptos supplies consensus, ordering, finality and Move execution. Permissioned delivery/cache operators provide a measurable service;.", "source_path": "docs/london-0.1.0/01-executive-architecture.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:994500532ad2adbb1c650c1e81371dbd06c2e3b1bf9621013c5ea35a321d6eca", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_02_system_architecture_md"}) SET n += {"id": "doc_docs_london_0_1_0_02_system_architecture_md", "type": "document", "label": "London DRAFT: System architecture", "description": "--- id: 02-system-architecture title: \"System architecture\" sidebarposition: 3 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Components and durable boundaries Component Owns Failure behaviour --------- Auth/entitlement Identity session, subscription access interval Deny new playback if authoritative state unavailable Catalogue Rights version, territory, asset manifest Deny unknown or withdrawn work Gateway.", "source_path": "docs/london-0.1.0/02-system-architecture.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:253552cd16f94622d324a28669f366c4627d3847d83c63c101f250d29d65e063", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_03_roles_and_trust_model_md"}) SET n += {"id": "doc_docs_london_0_1_0_03_roles_and_trust_model_md", "type": "document", "label": "London DRAFT: Roles and trust model", "description": "--- id: 03-roles-and-trust-model title: \"Roles and trust model\" sidebarposition: 4 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Authority matrix Role Allowed Forbidden --------- Listener Own access, sessions and support/disputes Set settlement duration, submit payable receipts, control treasury Rights holder Propose own works/splits, verify payout account, inspect own accrual Assert third-party rights without.", "source_path": "docs/london-0.1.0/03-roles-and-trust-model.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:f3020b300c9b953c4a2c8d0b9ec6d4077182b19bc6d570403f931c43f41ff493", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_04_listener_and_artist_journeys_md"}) SET n += {"id": "doc_docs_london_0_1_0_04_listener_and_artist_journeys_md", "type": "document", "label": "London DRAFT: Listener, artist and operator journeys", "description": "--- id: 04-listener-and-artist-journeys title: \"Listener, artist and operator journeys\" sidebarposition: 5 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Listener journey 1. Authenticate through the selected identity provider using authorization code with PKCE. Backend validates issuer, audience, state and nonce, then sets a secure HttpOnly session cookie. No wallet is required. 2. Purchase a GBP subscription.", "source_path": "docs/london-0.1.0/04-listener-and-artist-journeys.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:65f811c66af186002016936bb57cb4dcb8c362ad7e9db9aee837f63505cb4189", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_05_catalogue_rights_and_content_md"}) SET n += {"id": "doc_docs_london_0_1_0_05_catalogue_rights_and_content_md", "type": "document", "label": "London DRAFT: Catalogue, rights and content", "description": "--- id: 05-catalogue-rights-and-content title: \"Catalogue, rights and content\" sidebarposition: 6 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Registration and asset pipeline Catalogue lifecycle: draft - quarantined - rightsreview - approved - active - withdrawn. Malware checks, media decode validation, duplicate detection and rights review precede publication. Masters and derived renditions use distinct.", "source_path": "docs/london-0.1.0/05-catalogue-rights-and-content.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:01f4fa57ecb50c4b5f85b05cc3d560bd6e658f25a4846da6b415a973b4094e46", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_06_streaming_delivery_and_attestation_md"}) SET n += {"id": "doc_docs_london_0_1_0_06_streaming_delivery_and_attestation_md", "type": "document", "label": "London DRAFT: Streaming, delivery and attestation", "description": "--- id: 06-streaming-delivery-and-attestation title: \"Streaming, delivery and attestation\" sidebarposition: 7 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Playback authorisation Use gateway-signed range URLs to Porto-controlled serving endpoints, not direct client S3 URLs. Claims include schemaversion, keyid, sessionid, grantid, random 256-bit nonce, work/rendition/rights version, exact byte interval,.", "source_path": "docs/london-0.1.0/06-streaming-delivery-and-attestation.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:764804daf60d730ae324dc687f668626efaf269f6920ade5b45eeac70dfcbae6", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_07_fraud_controls_and_disputes_md"}) SET n += {"id": "doc_docs_london_0_1_0_07_fraud_controls_and_disputes_md", "type": "document", "label": "London DRAFT: Fraud controls and disputes", "description": "--- id: 07-fraud-controls-and-disputes title: \"Fraud controls and disputes\" sidebarposition: 8 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Decision pipeline Validate schema/signature, operator/key validity interval, grant consumption, lease generation, catalogue version, chunk digest, successful bytes and uniqueness before scoring. Invalid cryptographic or integrity evidence is rejected. Missing.", "source_path": "docs/london-0.1.0/07-fraud-controls-and-disputes.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:712c46053df7c120c47e764d9718bc91ea9f44a3d1e0d7a92a2c890b1010950b", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_08_usdc_treasury_and_settlement_md"}) SET n += {"id": "doc_docs_london_0_1_0_08_usdc_treasury_and_settlement_md", "type": "document", "label": "London DRAFT: USDC treasury and settlement", "description": "--- id: 08-usdc-treasury-and-settlement title: \"USDC treasury and settlement\" sidebarposition: 9 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Money states and ownership Each arrow requires an append-only ledger event, evidence reference, unique business ID and authorised actor. Exceptions branch from every state to held, failed, refundpending, reversalrecorded or recoveryopen; they never erase history..", "source_path": "docs/london-0.1.0/08-usdc-treasury-and-settlement.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:9fe8b4ca2e819c9ff603c3b744b2e6f6ef54ffcf72b887d95c5f04eff0661fc9", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_09_move_contract_specification_md"}) SET n += {"id": "doc_docs_london_0_1_0_09_move_contract_specification_md", "type": "document", "label": "London DRAFT: Move contract specification", "description": "--- id: 09-move-contract-specification title: \"Move contract specification\" sidebarposition: 10 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Shared contract rules All interfaces below are pseudocode only, not compilable Move. SECURITY REVIEW REQUIRED: exact framework API, resource-account or object custody and upgrade compatibility must be pinned and audited before coding/deployment. Six modules share a.", "source_path": "docs/london-0.1.0/09-move-contract-specification.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:39ad1376370e4326f875ac0c4491e0e338e881861d75037e66e40f3e73c507d4", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_10_off_chain_services_and_apis_md"}) SET n += {"id": "doc_docs_london_0_1_0_10_off_chain_services_and_apis_md", "type": "document", "label": "London DRAFT: Off-chain services and APIs", "description": "--- id: 10-off-chain-services-and-apis title: \"Off-chain services and APIs\" sidebarposition: 11 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Service boundaries The backend may start as a modular deployment, but data ownership and signing identities must follow these boundaries: identity/entitlement, catalogue, session gateway, receipt ingest, fraud review, attestation builder, finance ledger, settlement.", "source_path": "docs/london-0.1.0/10-off-chain-services-and-apis.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:e7a6964508b9d55285b2b402f73cfc81444048699a4bb0e530a662a2cb107a96", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_11_data_model_and_event_schemas_md"}) SET n += {"id": "doc_docs_london_0_1_0_11_data_model_and_event_schemas_md", "type": "document", "label": "London DRAFT: Data model and event schemas", "description": "--- id: 11-data-model-and-event-schemas title: \"Data model and event schemas\" sidebarposition: 12 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Persistent records Entity Key and constraints Source of truth --------- Identity random listener ID; provider subject unique Restricted identity store Subscription subscription ID; service interval; provider payment references Finance plus entitlement projection.", "source_path": "docs/london-0.1.0/11-data-model-and-event-schemas.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:f8b778a8e121e2ebad4ae4bac776d2f280711f9d012cee3a16be444b557f6055", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_12_security_privacy_and_key_management_md"}) SET n += {"id": "doc_docs_london_0_1_0_12_security_privacy_and_key_management_md", "type": "document", "label": "London DRAFT: Security, privacy and key management", "description": "--- id: 12-security-privacy-and-key-management title: \"Security, privacy and key management\" sidebarposition: 13 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Key separation and threats Key/credential Custody and scope Rotation/incident rule --------- Gateway grant signer Managed isolated signer, grant domain only Publish new key ID; retain old verification through grant expiry; revoke immediately for.", "source_path": "docs/london-0.1.0/12-security-privacy-and-key-management.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:078af1b6c341ecaf74ad3d4e9479f44331c5d35f5daf7f59714115dadf9c2236", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_13_operations_observability_and_incidents_md"}) SET n += {"id": "doc_docs_london_0_1_0_13_operations_observability_and_incidents_md", "type": "document", "label": "London DRAFT: Operations, observability and incidents", "description": "--- id: 13-operations-observability-and-incidents title: \"Operations, observability and incidents\" sidebarposition: 14 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Environment topology Local: synthetic identity/payment adapters, local media fixtures and local chain or mocked chain adapter, always labelled simulation. Staging: isolated AWS account, private origin/evidence, test identities, provider sandbox,.", "source_path": "docs/london-0.1.0/13-operations-observability-and-incidents.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:bfa5f754e094e9257a4866056bf0fd9143354bdf48ba13894ef2bd665ceef2a2", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_14_testing_and_launch_gates_md"}) SET n += {"id": "doc_docs_london_0_1_0_14_testing_and_launch_gates_md", "type": "document", "label": "London DRAFT: Testing and launch gates", "description": "--- id: 14-testing-and-launch-gates title: \"Testing and launch gates\" sidebarposition: 15 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Verification strategy Use the [acceptance catalogue](22-acceptance-test-catalogue.md) as traceability IDs. Backend tests must use contract fixtures and controlled clocks; frontend tests verify displayed evidence state; Move tests verify state/asset invariants. Every result.", "source_path": "docs/london-0.1.0/14-testing-and-launch-gates.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:e8c779980e0121ea22537384d7d366d547a181f36d35dd2796d7a6a46ce1db08", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_15_migration_to_porto_app_chain_md"}) SET n += {"id": "doc_docs_london_0_1_0_15_migration_to_porto_app_chain_md", "type": "document", "label": "London DRAFT: Future Porto app-chain migration", "description": "--- id: 15-migration-to-porto-app-chain title: \"Future Porto app-chain migration\" sidebarposition: 16 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Future work, not a launch promise Stable content/work/operator/payout IDs, versioned evidence schemas, immutable allocation manifests and a chain adapter isolate Aptos-specific transaction construction. Chain adapters must expose submit, lookupbybusinessid,.", "source_path": "docs/london-0.1.0/15-migration-to-porto-app-chain.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:87bcc27f660b3f6668476691f4726e41777b9b03fb51c8c357b90564a11bf5bd", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_16_implementation_plan_md"}) SET n += {"id": "doc_docs_london_0_1_0_16_implementation_plan_md", "type": "document", "label": "London DRAFT: Implementation plan", "description": "--- id: 16-implementation-plan title: \"Implementation plan\" sidebarposition: 17 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Work packages and dependencies This is a delivery plan, not a dated roadmap or authorization to implement. Separate agents can use these package boundaries after ratification; no sub-agent work is required by this document task. Package Owner Inputs/dependencies Deliverable and exit.", "source_path": "docs/london-0.1.0/16-implementation-plan.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:e66cb4ea141764819fa97517feb63e1fb887de68ea9dbde59c138c3442aff881", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_17_open_decisions_and_risk_register_md"}) SET n += {"id": "doc_docs_london_0_1_0_17_open_decisions_and_risk_register_md", "type": "document", "label": "London DRAFT: Open decisions and risk register", "description": "--- id: 17-open-decisions-and-risk-register title: \"Open decisions and risk register\" sidebarposition: 18 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Production-blocking decisions Every row is OPEN DECISION. Owners are required roles, not assigned people. All remain unresolved in this specification; proposed test defaults are not approvals. A closure record must identify named approver, evidence, date,.", "source_path": "docs/london-0.1.0/17-open-decisions-and-risk-register.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:f7f02532dbea2853396b3830f6cc19f979cf89d419491714007e96a81f03363d", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_18_compatibility_with_existing_pips_md"}) SET n += {"id": "doc_docs_london_0_1_0_18_compatibility_with_existing_pips_md", "type": "document", "label": "London DRAFT: Compatibility with existing PIPs", "description": "--- id: 18-compatibility-with-existing-pips title: \"Compatibility with existing PIPs\" sidebarposition: 19 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Status All source rows are CURRENT SOURCE, meaning static draft text as pinned in [source register](23-source-register.md). All London replacements are PROPOSED FOR LONDON 0.1.0, pending D12 governance acceptance. Nothing in this directory edits or supersedes.", "source_path": "docs/london-0.1.0/18-compatibility-with-existing-pips.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:c6f3b7eaee4bbbd7230eb8e230bf1e3d56c6555db6d595aff0b6c28a7c0a55a6", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_19_architecture_decisions_md"}) SET n += {"id": "doc_docs_london_0_1_0_19_architecture_decisions_md", "type": "document", "label": "London DRAFT: Architecture decision records", "description": "--- id: 19-architecture-decisions title: \"Architecture decision records\" sidebarposition: 20 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Proposed ADRs Each ADR is PROPOSED FOR LONDON 0.1.0, unaccepted pending listed decisions. ADR Context and choice Consequences and rejected alternative Gate ------------ ADR-001 Mainnet application Use Aptos consensus and native USDC settlement External chain dependency;.", "source_path": "docs/london-0.1.0/19-architecture-decisions.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:11fea88609d815e2b8acd6cf335c8dc6ba05b5af7e2550daeb91b03062e3480b", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_20_api_contracts_md"}) SET n += {"id": "doc_docs_london_0_1_0_20_api_contracts_md", "type": "document", "label": "London DRAFT: API contracts", "description": "--- id: 20-api-contracts title: \"API contracts\" sidebarposition: 21 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Normative common contract The machine-readable [OpenAPI contract](./openapi.json) in this directory is the request/response schema catalogue. All fields shown in request examples are required; unknown fields are rejected. Responses include schemaversion and correlationid. Request bodies include.", "source_path": "docs/london-0.1.0/20-api-contracts.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:061f8edc4d04806c23d3b716d5ad07533139c639112f8e800d42ad90db9ef12c", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_21_wire_and_commitment_contracts_md"}) SET n += {"id": "doc_docs_london_0_1_0_21_wire_and_commitment_contracts_md", "type": "document", "label": "London DRAFT: Wire encoding and commitment contracts", "description": "--- id: 21-wire-and-commitment-contracts title: \"Wire encoding and commitment contracts\" sidebarposition: 22 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Canonical signed input Receipt schema v1 fields, all required: schemaversion, receiptid, operatorid, keyversion, sessionid, grantid, requestid, leasegeneration, workid, rightsversion, renditionid, chunkindex, bytestart, byteendexclusive, byteswritten,.", "source_path": "docs/london-0.1.0/21-wire-and-commitment-contracts.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:cdedd40ed3ab97747d6f8b5428c01b938074d6365a6f55b3fa2c1dcab0d66b42", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_22_acceptance_test_catalogue_md"}) SET n += {"id": "doc_docs_london_0_1_0_22_acceptance_test_catalogue_md", "type": "document", "label": "London DRAFT: Acceptance test catalogue", "description": "--- id: 22-acceptance-test-catalogue title: \"Acceptance test catalogue\" sidebarposition: 23 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Required tests, not executed application evidence ID Setup/action Required result Owner/gate ------------ AT01 Expired entitlement, active browser session, request play 403, no grant, no payable evidence Backend G2 AT02 Two devices race for one account lease One succeeds;.", "source_path": "docs/london-0.1.0/22-acceptance-test-catalogue.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:dd3720026cddf4a82d0e992c80d8936b73b15482b72113d6628e5913d26d8e03", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_23_source_register_md"}) SET n += {"id": "doc_docs_london_0_1_0_23_source_register_md", "type": "document", "label": "London DRAFT: Source register and evidence boundaries", "description": "--- id: 23-source-register title: \"Source register and evidence boundaries\" sidebarposition: 24 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Current source evidence Reviewed 22 September 2026. Source hashes below pin local file bytes, with repository HEAD for navigation. A commit link describes that repository revision; where local bytes differ, the SHA-256 is the exact review identity. Existing sources are.", "source_path": "docs/london-0.1.0/23-source-register.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:5cc36d513af1dd56fa4729594894e6721544723f8195cd6c408665fa16225647", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_24_validation_and_impact_md"}) SET n += {"id": "doc_docs_london_0_1_0_24_validation_and_impact_md", "type": "document", "label": "London DRAFT: Validation and impact report", "description": "--- id: 24-validation-and-impact title: \"Validation and impact report\" sidebarposition: 25 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Scope of evidence This report records documentation validation only. No application tests, provider integration, Move deployment or real-money settlement were performed. The acceptance catalogue is future required test coverage. Validation record Validation completed for the.", "source_path": "docs/london-0.1.0/24-validation-and-impact.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:ce6a86cfddff62334504f7a7ad3583d7bed9a89796dd924c3465ea824b07500c", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_glossary_md"}) SET n += {"id": "doc_docs_london_0_1_0_glossary_md", "type": "document", "label": "London DRAFT: Glossary", "description": "--- id: glossary title: \"Glossary\" sidebarposition: 100 --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION Term Exact meaning ------ Audio bytes served Server-observed bytes written for authorised requests. Does not establish receipt, decoding or attention by a person. Eligible stream Closed session whose approved unique served duration reaches the configured threshold, before final attestation commitment. Attested.", "source_path": "docs/london-0.1.0/glossary.md", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:c51ea3ada5f8db122e72d052af6018a3f1c72a8615cb797f8dd1336deafc0ec4", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_index_mdx"}) SET n += {"id": "doc_docs_london_0_1_0_index_mdx", "type": "document", "label": "London DRAFT: London 0.1.0", "description": "--- id: index title: \"London 0.1.0\" sidebarlabel: \"Start here (Draft)\" sidebarposition: 0 slug: /overview --- DRAFT \u00b7 PROPOSED \u00b7 IMPLEMENTATION SPECIFICATION London 0.1.0 specifies a proposed real-money music MVP on Aptos Mainnet: GBP subscriptions, Porto-owned treasury conversion, native USDC settlement, private origin storage, permissioned delivery operators and Porto-trusted attestation. It launches no PRT, Porto.", "source_path": "docs/london-0.1.0/index.mdx", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:070f44687e66c29d880c1a3e4164c40b13fda76d24ed527fad2a649f7f159ad1", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_openapi_json"}) SET n += {"id": "doc_docs_london_0_1_0_openapi_json", "type": "document", "label": "London DRAFT: openapi", "description": "{ \"openapi\": \"3.1.0\", \"info\": { \"title\": \"London 0.1.0 DRAFT implementation API\", \"version\": \"0.1.0\", \"description\": \"PROPOSED FOR LONDON 0.1.0. Implementation specification only. No deployed server.\" }, \"servers\": [ { \"url\": \"https://api.example.invalid\", \"description\": \"Non-routable documentation placeholder\" } ], \"paths\": { \"/v1/auth/exchange\": { \"post\": { \"operationId\": \"AuthExchange\", \"summary\": \"AuthExchange\",.", "source_path": "docs/london-0.1.0/openapi.json", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:c7038b282d01909a583a1b3a99652beaa43dffa3d35c6370fe8569a73fea13d2", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_source_manifest_json"}) SET n += {"id": "doc_docs_london_0_1_0_source_manifest_json", "type": "document", "label": "London DRAFT: source-manifest", "description": "{ \"status\": \"DRAFT\", \"reviewdate\": \"2026-09-22\", \"sources\": [ { \"path\": \"whitepaper/porto-whitepaper.md\", \"sha256\": \"87855bd3352335a843849681e90a30058c95ae68e5fc4181327e6e4ef23c394d\", \"repositoryrevision\": \"d902041c348b199d1dd2de5ab73de24ff5a26e67\", \"sections\": [ \"3.2 System overview\", \"3.3 The revenue split\", \"4.2 Built on a stripped, detached fork of Aptos\", \"6.2 Beta architecture: trusted, region-co-located S3.", "source_path": "docs/london-0.1.0/source-manifest.json", "source_repository": "london-draft", "authority": "proposed_implementation_specification", "classification": "public", "kind": "draft_proposal", "materialized": true, "source_hash": "sha256:a75d4a6a381a0c46ce8865681ef6e0fac8d3235ee50dfba08acc4354987ec618", "source_revision": "fdb5d3f54f856658a2fdcbeb755de72bc4243dff"};
