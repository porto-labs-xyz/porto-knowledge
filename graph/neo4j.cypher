MERGE (n:Node {id: "doc_docs_docs_intro_mdx"}) SET n += {"id": "doc_docs_docs_intro_mdx", "type": "document", "label": "Porto Documentation", "description": "--- id: intro title: Porto Docs slug: / sidebarposition: 0 --- Porto Docs Porto is decentralized streaming infrastructure that replaces platform-owned delivery and settlement with a network run by artists, labels, publishers, and independent node operators. This site has two sections, both pulled directly from their source-of-truth repos at build time , nothing here is hand-copied: - [Whitepaper](/whitepaper) , the.", "source_path": "docs/docs/intro.mdx", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "published", "materialized": true, "source_hash": "sha256:c4bcf9410d7a23dc996d971ca8f4a18800266152e81e61c6740663881e64d1b8", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_index_md"}) SET n += {"id": "doc_docs_docs_pips_index_md", "type": "document", "label": "Index", "description": "--- id: \"index\" title: \"Porto Improvement Proposals\" slug: \"/pips\" --- Porto Improvement Proposals (PIPs) PIPs are the design documents for the Porto protocol \u2014 Porto Chain, the PRT token, stream accounting, payouts, node operation, and governance \u2014 written in an EIP/RFC-style format. See [PIP-1](/pips/pip-1) for the full process, PIP types, and status lifecycle. Start with [PIP-2](/pips/pip-2) for the non-technical.", "source_path": "docs/docs/pips/index.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:efef7d60bc0e4e20d24c0244f248ec6dd5fe7b67f8933d32824e3001a038d2b2", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_pip_1_md"}) SET n += {"id": "doc_docs_docs_pips_pip_1_md", "type": "document", "label": "Pip 1", "description": "--- id: \"pip-1\" title: \"PIP-1: PIP Purpose, Process, and Format\" sidebarlabel: \"PIP-1 , PIP Purpose, Process, and Format\" sidebarposition: 1 slug: \"/pips/pip-1\" --- What is a PIP? PIP stands for Porto Improvement Proposal. A PIP is a design document providing information to the Porto community, or describing a new feature for Porto, its Move modules, the Porto Chain protocol, or the Porto network's economic and.", "source_path": "docs/docs/pips/pip-1.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:9d8d04e97d1929dfdd9e2781020cb88154429b66a1262dcee968bf704abeee21", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_pip_2_md"}) SET n += {"id": "doc_docs_docs_pips_pip_2_md", "type": "document", "label": "Pip 2", "description": "--- id: \"pip-2\" title: \"PIP-2: Porto Network Overview\" sidebarlabel: \"PIP-2 , Porto Network Overview\" sidebarposition: 2 slug: \"/pips/pip-2\" --- Simple Summary Porto is decentralized streaming infrastructure that replaces the platform-owned delivery layer of music streaming with a network that artists, labels, and node operators own and run themselves, settling royalties transparently and automatically on-chain..", "source_path": "docs/docs/pips/pip-2.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:dc0f77427a70d87768550af763d84f03f7dcb5b51cb8d73ac7b5eb85c2a3f874", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_pip_3_md"}) SET n += {"id": "doc_docs_docs_pips_pip_3_md", "type": "document", "label": "Pip 3", "description": "--- id: \"pip-3\" title: \"PIP-3: PRT Fungible Asset & Issuance Standard\" sidebarlabel: \"PIP-3 , PRT Fungible Asset & Issuance Standard\" sidebarposition: 3 slug: \"/pips/pip-3\" --- Simple Summary PRT is Porto's native token, implemented as an Aptos-standard Fungible Asset. Unlike a fixed-supply or block-reward-emitted token, PRT is minted only against real, inbound subscription value, and it is the sole unit in which.", "source_path": "docs/docs/pips/pip-3.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:08d42ce5c20986c12b12b26ef1e815c32ca3db9c07d5d8fd7cd925f314068e10", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_pip_4_md"}) SET n += {"id": "doc_docs_docs_pips_pip_4_md", "type": "document", "label": "Pip 4", "description": "--- id: \"pip-4\" title: \"PIP-4: Stream Accounting & Attestation Protocol\" sidebarlabel: \"PIP-4 , Stream Accounting & Attestation Protocol\" sidebarposition: 4 slug: \"/pips/pip-4\" --- Simple Summary Every play of a musical work on Porto is served from an audio origin, confirmed by an attestor as actually having been served for a minimum duration, and recorded on-chain as a StreamEvent that becomes the sole trigger for.", "source_path": "docs/docs/pips/pip-4.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:af23bbbc372cb76327b4755fc7344418246fe5a10fad8132f1f4cdb43fa89b32", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_pip_5_md"}) SET n += {"id": "doc_docs_docs_pips_pip_5_md", "type": "document", "label": "Pip 5", "description": "--- id: \"pip-5\" title: \"PIP-5: Payout Splitter Module\" sidebarlabel: \"PIP-5 , Payout Splitter Module\" sidebarposition: 5 slug: \"/pips/pip-5\" --- Simple Summary The payoutsplitter module converts finalized StreamEvents into actual PRT payouts, using a user-centric (listener-attributed) settlement model rather than a platform-wide pro-rata pool, and applies the 70/25/5 network-level split within each listener's own.", "source_path": "docs/docs/pips/pip-5.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:8eaab5202e03e700b0e667c6efe89372fc3f1591b1b6be1e13c1636a3c661b02", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_pip_6_md"}) SET n += {"id": "doc_docs_docs_pips_pip_6_md", "type": "document", "label": "Pip 6", "description": "--- id: \"pip-6\" title: \"PIP-6: Node Operator Registration, Roles & Staking\" sidebarlabel: \"PIP-6 , Node Operator Registration, Roles & Staking\" sidebarposition: 6 slug: \"/pips/pip-6\" --- Simple Summary Specifies the three node operating modes (CDN, Validator, Full), the PRT-denominated staking and unbonding mechanism operators must go through to register, and the slashing conditions that secure the Mainnet V1.", "source_path": "docs/docs/pips/pip-6.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:80455baa68cfc9df105b5fec6548354ac4be1d25bd3caa9bc45818ad4ff2c785", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_pips_pip_7_md"}) SET n += {"id": "doc_docs_docs_pips_pip_7_md", "type": "document", "label": "Pip 7", "description": "--- id: \"pip-7\" title: \"PIP-7: Governance Parameters & Upgrade Process\" sidebarlabel: \"PIP-7 , Governance Parameters & Upgrade Process\" sidebarposition: 7 slug: \"/pips/pip-7\" --- Simple Summary Specifies the governance-controlled parameter set referenced throughout this PIP series, and the process by which Porto Chain's modules are upgraded \u2014 beginning with single-key governance during Beta, with a disclosed,.", "source_path": "docs/docs/pips/pip-7.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:51da18575faf87662e388c9c9737ebed98b1b77dedf9151f1b036e047231d63c", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_docs_docs_whitepaper_md"}) SET n += {"id": "doc_docs_docs_whitepaper_md", "type": "document", "label": "Published Whitepaper", "description": "--- id: \"whitepaper\" title: \"Whitepaper\" sidebarposition: 1 slug: \"/whitepaper\" --- Porto: A Network-Owned Infrastructure Layer for Music Distribution v0.1.0 , Draft Richard Melkonian, Porto Labs [redacted-email] This is the canonical Porto whitepaper , the single, in-depth narrative source. Normative technical specifications, written in an EIP/RFC-style format, live separately in the [Porto Improvement Proposal.", "source_path": "docs/docs/whitepaper.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "published", "materialized": true, "source_hash": "sha256:8f56fa5a527eaed392482fc3b49603bce625b0662ed85c154fecd3463b16fc92", "source_revision": "f1ea0d975d1e530ba921ab6ac4b9c0423daa440d"};
MERGE (n:Node {id: "doc_pips_pip_1_md"}) SET n += {"id": "doc_pips_pip_1_md", "type": "document", "label": "PIP-1: Process", "description": "What is a PIP? PIP stands for Porto Improvement Proposal. A PIP is a design document providing information to the Porto community, or describing a new feature for Porto, its Move modules, the Porto Chain protocol, or the Porto network's economic and operational surrounding it. The PIP should provide a concise technical specification of the feature and a rationale for it. The PIP author is responsible for building.", "source_path": "pips/PIP-1.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:8157d21de126b4b5fb5a47f55e86e7c6b4d6667e6402bcf6b159b2a48772305b", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_pip_2_md"}) SET n += {"id": "doc_pips_pip_2_md", "type": "document", "label": "PIP-2: Network Architecture", "description": "Simple Summary Porto is decentralized streaming infrastructure that replaces the platform-owned delivery layer of music streaming with a network that artists, labels, and node operators own and run themselves, settling royalties transparently and automatically on-chain. Abstract This PIP is informational: it does not specify protocol behavior. It records the problem Porto exists to solve, the shape of the solution,.", "source_path": "pips/PIP-2.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:8278fcd18b9a6c6a38aff60ca913896e99b2f794d19bf1c2c4e3220251dfc9a7", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_pip_3_md"}) SET n += {"id": "doc_pips_pip_3_md", "type": "document", "label": "PIP-3: PRT Token Model", "description": "Simple Summary PRT is Porto's native token, implemented as an Aptos-standard Fungible Asset. Unlike a fixed-supply or block-reward-emitted token, PRT is minted only against real, inbound subscription value, and it is the sole unit in which listener demand, node-operator compensation, and rights-holder payouts are denominated. Abstract This PIP specifies the PRT token: its on-chain representation, its issuance.", "source_path": "pips/PIP-3.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:6b03d6a1f3c15a09b3eeaae9edf13751c19a2e074cd3f3b53c1e571c2aa5cc94", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_pip_4_md"}) SET n += {"id": "doc_pips_pip_4_md", "type": "document", "label": "PIP-4: Streaming and Attestation", "description": "Simple Summary Every play of a musical work on Porto is served from an audio origin, confirmed by an attestor as actually having been served for a minimum duration, and recorded on-chain as a StreamEvent that becomes the sole trigger for payout. This PIP specifies the on-chain streamaccounting module and, in detail, the Beta-phase streaming architecture: trusted-region, co-located S3 origin storage with a single.", "source_path": "pips/PIP-4.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:f8ce0ff3419c4eaa375d5711aecb2607831ad0864637f79f57ca3296a8552121", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_pip_5_md"}) SET n += {"id": "doc_pips_pip_5_md", "type": "document", "label": "PIP-5: Listener-Centric Payouts", "description": "Simple Summary The payoutsplitter module converts finalized StreamEvents into actual PRT payouts, using a user-centric (listener-attributed) settlement model rather than a platform-wide pro-rata pool, and applies the 70/25/5 network-level split within each listener's own subscription allotment. Abstract This PIP specifies how value moves from a listener's subscription mint to rights holders, node operators, and the.", "source_path": "pips/PIP-5.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:e73552a699a3fe0dddcccc330497e5a83e4dd8005cdbf8748192006eaf99c621", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_pip_6_md"}) SET n += {"id": "doc_pips_pip_6_md", "type": "document", "label": "PIP-6: Node Operations", "description": "Simple Summary Specifies the three node operating modes (CDN, Validator, Full), the PRT-denominated staking and unbonding mechanism operators must go through to register, and the slashing conditions that secure the Mainnet V1 multi-attestor model described in [PIP-4](./PIP-4.md). Abstract Node operator staking is load-bearing for two separable things Porto asks of it: (1) skin-in-the-game for participants earning.", "source_path": "pips/PIP-6.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:c5bb3791ed70a217efa6ef4e40cb36de9ce0f934190bac9c9f0f4dd1f2b287fd", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_pip_7_md"}) SET n += {"id": "doc_pips_pip_7_md", "type": "document", "label": "PIP-7: Governance", "description": "Simple Summary Specifies the governance-controlled parameter set referenced throughout this PIP series, and the process by which Porto Chain's modules are upgraded \u2014 beginning with single-key governance during Beta, with a disclosed, explicit migration path to broader participation. Abstract Multiple PIPs in this series (network split percentages in [PIP-2](./PIP-2.md), the PRT conversion rate and gas-burn policy in.", "source_path": "pips/PIP-7.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:8f59c0c02258c4e58eab76b6781d16c0700323dfea6baeb686adc81e981e0f04", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_pip_8_md"}) SET n += {"id": "doc_pips_pip_8_md", "type": "document", "label": "PIP-8: Economic Loop", "description": "Simple Summary Defines the complete economic loop for Porto: a listener payment enters the Treasury Reserve, the Treasury mints PRT against that cleared payment, the listener's own PRT allotment follows their listening, and finalized stream events settle that value between rights holders, node operators, and the protocol treasury. It also defines the supply, reserve, redemption, staking, fee, and governance.", "source_path": "pips/PIP-8.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "normative", "materialized": true, "source_hash": "sha256:28769230152dfdd5c340b8817e32105ff0318c1d3d1db7284e738e86f686f485", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_pips_readme_md"}) SET n += {"id": "doc_pips_readme_md", "type": "document", "label": "Porto Improvement Proposals", "description": "Porto Improvement Proposals (PIPs) PIPs are the design documents for the Porto protocol \u2014 Porto Chain, the PRT token, stream accounting, payouts, node operation, and governance \u2014 written in an EIP/RFC-style format. See [PIP-1](./PIP-1.md) for the full process, PIP types, and status lifecycle. Start with [PIP-2](./PIP-2.md) for the non-technical overview (the problem, the solution, and how the rest of this series.", "source_path": "pips/README.md", "source_repository": "pips", "authority": "normative_protocol", "classification": "internal", "kind": "index", "materialized": true, "source_hash": "sha256:6d03514229431cd2183bb07427cfba9f3f60655cc08fc60b1654d463c9a3476a", "source_revision": "f7211bb1df96a42be8001f3148df9b5be11c111b"};
MERGE (n:Node {id: "doc_porto_design_system_agents_md"}) SET n += {"id": "doc_porto_design_system_agents_md", "type": "document", "label": "Agents", "description": "Porto Design System package instructions Use released package content only. Do not ingest restricted deck PDFs, private valuations, biographies or local source paths. Read the design-system skill before producing a Porto visual artifact. Keep Figma node IDs and links in figma/release-manifest.json; do not invent them. Before visual work, query the private organisation graph from the Porto workspace: python3.", "source_path": "porto-design-system/AGENTS.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:c2684c63e93d62976e74ea857e25d549e587ae3fc78b639db501f0e1a1c06a23", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_changelog_md"}) SET n += {"id": "doc_porto_design_system_changelog_md", "type": "document", "label": "Changelog", "description": "Changelog 0.1.0-dev.1, 2026-09-18 - First portable Porto design-system release package. - Added verified landing starting tokens and approved asset registry. - Added complete Figma construction specification and template inventories. - Native Figma library not yet created. This is intentionally a development release.", "source_path": "porto-design-system/CHANGELOG.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:868ffcef2603ff2d8c05f12d5d06e2589631de415d828ba9b3c90d411e2251e2", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_coverage_md"}) SET n += {"id": "doc_porto_design_system_coverage_md", "type": "document", "label": "Coverage", "description": "Coverage matrix Area Local release Native Figma --- --- --- 00 Start Here figma/IMPORT.md, README Blocked 01 Foundations tokens/, specifications/foundations.md Blocked 02 Identity specifications/identity-imagery.md Blocked 03 Illustration and imagery asset registry Blocked 04 Core components specifications/components.md Blocked 05 Data visualisation specifications/data-viz.md Blocked 06 Website library.", "source_path": "porto-design-system/COVERAGE.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:6b62e607eafccb33a33e5d9783779e3e738a1298ac632c62f8d5127e16df9743", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_decisions_md"}) SET n += {"id": "doc_porto_design_system_decisions_md", "type": "document", "label": "Decisions", "description": "Decisions Decision Status Basis --- --- --- Dark palette starts 090A0A, paper EEE8DC, muted B9B2A5, accent EE6251 Approved website starting values, verified Landing CSS Deck uses Avenir Next with selective IBM Plex Mono Approved Design notes Website uses DM Sans with selective IBM Plex Mono Approved Landing voice and CSS 70/25/5 uses cream, violet and blue respectively Approved Latest visual direction and.", "source_path": "porto-design-system/DECISIONS.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:f0a36badeba55fa242d23367e5b2c2f2b98d694a69825468b7711fb43ffa4587", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_plan_md"}) SET n += {"id": "doc_porto_design_system_plan_md", "type": "document", "label": "Plan", "description": "Plan Milestone Acceptance criterion Status --- --- --- 1. Source audit Current deck, landing tokens, assets and product qualifications recorded Complete 2. Foundations Native-variable-ready tokens and mode rules released Complete 3. Library Component, chart and website specifications released Complete locally 4. Templates Presentation, document and marketing frame inventories released Complete locally 5. Native.", "source_path": "porto-design-system/PLAN.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:d104062e87307ea852cd22b62ff1d09e6e6dfc09c578dd8db1d3d6a6a6f8d3eb", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_readme_md"}) SET n += {"id": "doc_porto_design_system_readme_md", "type": "document", "label": "Porto Design System", "description": "Porto Design System Release 0.1.0-dev.1, prepared for native Figma implementation. Porto is streaming infrastructure for artists and record labels. This package is the released companion to an editable Figma library. It is deliberately portable: restricted decks, biographies, valuation material and machine-specific source paths are excluded. What is in the release - tokens/porto.tokens.json: primitive and semantic.", "source_path": "porto-design-system/README.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "design", "materialized": true, "source_hash": "sha256:97c9c32dc935ef325cccb3b2c1e7801bbb84bb499edb4cbbe06fd8705ab5b00c", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_status_md"}) SET n += {"id": "doc_porto_design_system_status_md", "type": "document", "label": "Status", "description": "Status Version: 0.1.0-dev.1 Current task: await Figma authentication, then create the private project and execute the import/build order in figma/IMPORT.md. Blocker: https://www.figma.com/files/ presents an unauthenticated sign-in form. No account, team, destination or edit permission can be verified. Next action: user signs into the intended private Figma workspace, then return here to create and inspect the.", "source_path": "porto-design-system/STATUS.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:8420b0c54227fb08d71cb9c0b2f188873c49deadbc0b172476704dc9f654ff70", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_examples_representative_briefs_md"}) SET n += {"id": "doc_porto_design_system_examples_representative_briefs_md", "type": "document", "label": "Representative Briefs", "description": "Representative end-to-end briefs Deck, public investor introduction Audience: early-stage music infrastructure investors. Purpose: explain why distribution ownership matters. Channel: 16:9 deck. Mode: Marketing Dark. Privacy: public-safe. Content source: whitepaper and PIP-5 only for specific settlement claims. Output: PDF and editable Figma presentation. Required pages: cover, problem, Porto Venn, product, exact.", "source_path": "porto-design-system/examples/representative-briefs.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:7f9b13654141e0ad0edc08b8e3ed1903948bbdaff5c39167896e10b1e6ea3a6a", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_figma_import_md"}) SET n += {"id": "doc_porto_design_system_figma_import_md", "type": "document", "label": "Import", "description": "Native Figma build and import order Destination Create a private project named Porto Design System. Create three files: Porto DS Library, Porto DS Templates, Porto DS Examples. Publish the library only within the confirmed private team. Build order 1. Import tokens/porto.tokens.json into native Figma Variables. Create collections Primitive, Semantic, Mode and Typography. Confirm aliases resolve in Dark, Editorial.", "source_path": "porto-design-system/figma/IMPORT.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:af4bc465fcea2ad8161f969b4830a94375f206c551f539d816bbb5bbd047c7ab", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_skills_porto_design_system_skill_md"}) SET n += {"id": "doc_porto_design_system_skills_porto_design_system_skill_md", "type": "document", "label": "Skill", "description": "--- name: porto-design-system description: Create Porto decks, documents and marketing assets from a released Porto Design System package and verified Figma library. Use for Porto visual communications, not protocol implementation or legal drafting. --- Porto Design System Before applying this skill to a Porto deck, marketing asset or public visual, query ../porto-knowledge/scripts/knowledge.py route marketing-deck.", "source_path": "porto-design-system/skills/porto-design-system/SKILL.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:50c08448113fa08c88e66b20902f233ad05d14273a443f439f2f5c7ac501b8c1", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_specifications_components_md"}) SET n += {"id": "doc_porto_design_system_specifications_components_md", "type": "document", "label": "Components", "description": "Components Implement each line as a Figma main component, using semantic variants, Auto Layout and properties named exactly as shown. Family Component and variants Properties / behaviour --- --- --- Typography Type/Heading, Type/Eyebrow, Type/Body, Type/Citation Mode, level, emphasis; text property; body grows vertically. Navigation Web/Nav, Web/Nav-link, Web/Button Desktop/mobile, active, hover, focus, pressed,.", "source_path": "porto-design-system/specifications/components.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:ddc1283c9680ed38b70c257da30f8466d8c6a5069cfadef3f82a4b260d5c13fd", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_specifications_content_md"}) SET n += {"id": "doc_porto_design_system_specifications_content_md", "type": "document", "label": "Design Content Rules", "description": "Voice and content Direct, confident and concise. Speak to artists, labels and investors without hype. Avoid decentralized, web3, blockchain, crypto and NFT in hero or above-the-fold marketing. Use Suitable Avoid --- --- --- Headline Distribution should belong to the people who make the music. A revolutionary Web3 music future Economics 70% to rights holders, split by declared rights. Artists always receive 70%..", "source_path": "porto-design-system/specifications/content.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "design", "materialized": true, "source_hash": "sha256:b69ed8ea90cba76d557c0583fe4cb416f1e9c80a9180b25cabbefbcc66a3dcca", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_specifications_data_viz_md"}) SET n += {"id": "doc_porto_design_system_specifications_data_viz_md", "type": "document", "label": "Data Viz", "description": "Data visualisation Data is vector geometry. A decorative hatch is a separate clipped layer and is fixed in opacity, spacing and angle regardless of value. Component Required rule --- --- Data/Economics-bar Values use 0\u2013100 scale. Exact 8% and 70% fills. Coral hand-drawn finish, fine double contour, spaced diagonal hatch and endpoint construction mark. Wording: ~8p for every pound and Porto: up to 70p for every.", "source_path": "porto-design-system/specifications/data-viz.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:42c9976261ffa7d3b7e8edc4c8943b80a585fc012e8a188865329e73f96e5a19", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_specifications_foundations_md"}) SET n += {"id": "doc_porto_design_system_specifications_foundations_md", "type": "document", "label": "Design Foundations", "description": "Foundations Modes and frames Mode Use Frame and grid --- --- --- Marketing Dark Deck, landing, campaign 16:9: 1920\u00d71080, 12 columns, 64 outer margin, 24 gutter. Social: preserve at least 7% safe area. Editorial Light, proposed Reports, case studies, press materials A4 210\u00d7297 mm or US Letter 8.5\u00d711 in, 12 mm inner, 15 mm outer, 6 columns. Legal Plain Neutral legal presentation only A4 or US Letter, 25 mm margins,.", "source_path": "porto-design-system/specifications/foundations.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "design", "materialized": true, "source_hash": "sha256:7d948764032ab40a4b0c539ef9b1f0f862f5284bd7ef09fde7e13d58ae38ee32", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_specifications_identity_imagery_md"}) SET n += {"id": "doc_porto_design_system_specifications_identity_imagery_md", "type": "document", "label": "Identity Imagery", "description": "Identity, illustration and imagery Mark Use porto-mark-handdrawn.png as the approved broad P. Keep it square, preserve transparent margins and clear space equal to the red port diameter on every side. Minimum digital size: 24 px. Do not stretch, recolour the red port, add a shadow, introduce cyan glitches or substitute a generic P. The primary wordmark is supplied as editable text until a verified vector wordmark.", "source_path": "porto-design-system/specifications/identity-imagery.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:cb5346b3ee17fc346a43279d289edc37d2f30bdbb841ee6c1e12425b5cbe6fe9", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_templates_documents_md"}) SET n += {"id": "doc_porto_design_system_templates_documents_md", "type": "document", "label": "Documents", "description": "Document templates Template Minimum pages Key behaviour --- --- --- One-pager 1 Statement, three proof points, CTA and source line. Executive brief 2 Executive summary plus detail continuation. Report 4 Title, contents, section opener, table/chart, running header and page number. Litepaper / whitepaper 6 Multi-level headings, figure/table captions, citations, appendix. Case study 2 Context, method, result, evidence.", "source_path": "porto-design-system/templates/documents.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:0dd27fd201fc2c4ed4ee87605cdc530a206984184cc56501027bff46c34a7e58", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_templates_marketing_md"}) SET n += {"id": "doc_porto_design_system_templates_marketing_md", "type": "document", "label": "Marketing Template", "description": "Marketing templates Template Dimensions Layout variants --- --- --- Social square 1080\u00d71080 Headline, quote, statistic, announcement Social portrait 1080\u00d71350 Portrait, proof point, event Vertical 1080\u00d71920 Story sequence, announcement, event Campaign graphic 1920\u00d71080 Hero, evidence, product Link preview 1200\u00d7630 Headline with art, legible at thumbnail scale Carousel 1080\u00d71350 Cover, argument, statistic, CTA Event.", "source_path": "porto-design-system/templates/marketing.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "design", "materialized": true, "source_hash": "sha256:2ea62cd95264fd0e874cabf8ed45825cff7fd2ea7eb4d482042373bc3e5f73a7", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_templates_presentations_md"}) SET n += {"id": "doc_porto_design_system_templates_presentations_md", "type": "document", "label": "Presentation Template", "description": "Presentation templates, 16:9 All masters use 1920\u00d71080, Marketing Dark mode, a 12-column grid and 64 px safe margin. Place copy in editable Auto Layout stacks; the art layer is constrained independently. Master Required composition --- --- Deck/Cover Broad P, title, short positioning, right-side arch or pillar. Deck/Problem Broken-pillar background, 01 / The Problem, evidence panel. Deck/Porto Intact pillar, 02 /.", "source_path": "porto-design-system/templates/presentations.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "design", "materialized": true, "source_hash": "sha256:b67692009a98ee83ef545a1bd777b9cebfd6002db011fcec07dc941e33ab9b58", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_tokens_porto_tokens_json"}) SET n += {"id": "doc_porto_design_system_tokens_porto_tokens_json", "type": "document", "label": "Porto.Tokens", "description": "{ \"$schema\": \"https://design-tokens.github.io/community-group/format/\", \"meta\": { \"name\": \"Porto\", \"version\": \"0.1.0-dev.1\", \"authoritativeDirection\": \"Figma variables to released JSON\" }, \"color\": { \"charcoal\": { \"$value\": \"090A0A\", \"$type\": \"color\" }, \"paper\": { \"$value\": \"EEE8DC\", \"$type\": \"color\" }, \"muted\": { \"$value\": \"B9B2A5\", \"$type\": \"color\" }, \"coral\": { \"$value\": \"EE6251\", \"$type\": \"color\" }, \"violet\": {.", "source_path": "porto-design-system/tokens/porto.tokens.json", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:7685560d5bef8d4693c59f5a871c79c0439bc854413997c5896e9e375dfa272d", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_design_system_validation_release_checklist_md"}) SET n += {"id": "doc_porto_design_system_validation_release_checklist_md", "type": "document", "label": "Release Checklist", "description": "Release checklist - [ ] Figma project is private and ownership is confirmed. - [ ] Named Figma version maps to package version. - [ ] All listed component masters exist and have descriptions. - [ ] Instances remain linked after an edit to a master. - [ ] A variable change propagates to expected instances only. - [ ] Long headline, long label and table overflow are tested. - [ ] Economics bars are exactly 8% and 70%;.", "source_path": "porto-design-system/validation/release-checklist.md", "source_repository": "design-system", "authority": "released_design_system", "classification": "internal", "kind": "supporting", "materialized": true, "source_hash": "sha256:6a76055feb3bd26413138f4963f7dd5f83293b7913e0b58727ef0dd02cc14ab1", "source_revision": "cb55551e81cb0cebd247f06ac33ffe1b77565001"};
MERGE (n:Node {id: "doc_porto_landing_claude_md"}) SET n += {"id": "doc_porto_landing_claude_md", "type": "document", "label": "Porto Brand Voice", "description": "CLAUDE.md Context for Claude Code working in the Porto Labs landing page repo. This is a Gatsby static site. Lightweight. Copy and presentation only. What Porto Is Porto is streaming infrastructure for artists and record labels. Artists and labels own and run the network that delivers their music. Valid plays are logged on-chain. Revenue accrues during an epoch and splits automatically at settlement. PIP-5 specifies.", "source_path": "porto-landing/CLAUDE.md", "source_repository": "landing", "authority": "approved_brand_voice", "classification": "public", "kind": "brand", "materialized": true, "source_hash": "sha256:a4afd2a3e139c058998b498787117e5800f5f87fe8496ec9d6e4138e7e661d93", "source_revision": "1dc61479584654ad77c571618e054b5390f7f520"};
MERGE (n:Node {id: "doc_porto_landing_readme_md"}) SET n += {"id": "doc_porto_landing_readme_md", "type": "document", "label": "Readme", "description": "Porto Decentralized Streaming Infrastructure Setup Development Site runs at http://localhost:8000 Build Deploy", "source_path": "porto-landing/README.md", "source_repository": "landing", "authority": "approved_brand_voice", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:a9de153776e7b260658de2a18c0cb5a11a54e9700f0ffeb286c9bd1d11308b93", "source_revision": "1dc61479584654ad77c571618e054b5390f7f520"};
MERGE (n:Node {id: "doc_porto_landing_src_pages_index_jsx"}) SET n += {"id": "doc_porto_landing_src_pages_index_jsx", "type": "document", "label": "Porto Landing Page", "description": "import React, { useState } from 'react' const mission = 'We help artists and record labels earn more from streaming by letting them own the network that delivers their music, so they earn from distribution, not just plays.' const seoDescription = 'Artist-owned streaming infrastructure. Porto lets artists and labels own the network that delivers their music.' const contact = 'mailto:[redacted-email]' function.", "source_path": "porto-landing/src/pages/index.jsx", "source_repository": "landing", "authority": "approved_brand_voice", "classification": "public", "kind": "public_copy", "materialized": true, "source_hash": "sha256:5f575395df1e31bcbb464448b2575e0c25d22b0e7e17b8488d0f64bae1bd2730", "source_revision": "1dc61479584654ad77c571618e054b5390f7f520"};
MERGE (n:Node {id: "doc_whitepaper_readme_md"}) SET n += {"id": "doc_whitepaper_readme_md", "type": "document", "label": "Whitepaper Contents", "description": "Porto Whitepaper This repository contains the canonical Porto whitepaper: \"Porto: A Network-Owned Infrastructure Layer for Music Distribution.\" Porto is decentralized streaming infrastructure that replaces platform-owned delivery and settlement with a network run by artists, labels, publishers, and independent node operators. Every play is logged on Porto Chain, a purpose-built blockchain, and settled automatically.", "source_path": "whitepaper/README.md", "source_repository": "whitepaper", "authority": "company_product_intent", "classification": "internal", "kind": "index", "materialized": true, "source_hash": "sha256:76aa029957054011dc75668eb1e85ab993d0d4f49f022b9d86d14e147982b2ff", "source_revision": "d902041c348b199d1dd2de5ab73de24ff5a26e67"};
MERGE (n:Node {id: "doc_whitepaper_porto_whitepaper_md"}) SET n += {"id": "doc_whitepaper_porto_whitepaper_md", "type": "document", "label": "Porto Whitepaper", "description": "Porto: A Network-Owned Infrastructure Layer for Music Distribution v0.1.0 , Draft Richard Melkonian, Porto Labs [redacted-email] This is the canonical Porto whitepaper , the single, in-depth narrative source. Normative technical specifications, written in an EIP/RFC-style format, live separately in the [Porto Improvement Proposal (PIP) series](../pips/README.md) and are referenced throughout this document for.", "source_path": "whitepaper/porto-whitepaper.md", "source_repository": "whitepaper", "authority": "company_product_intent", "classification": "internal", "kind": "canonical", "materialized": true, "source_hash": "sha256:87855bd3352335a843849681e90a30058c95ae68e5fc4181327e6e4ef23c394d", "source_revision": "d902041c348b199d1dd2de5ab73de24ff5a26e67"};
