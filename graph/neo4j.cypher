MERGE (n:Node {id: "doc_docs_readme_md"}) SET n += {"id": "doc_docs_readme_md", "type": "document", "label": "Documentation build guidance", "description": "Porto Docs Source for [docs.portolabs.xyz](https://docs.portolabs.xyz), built with [Docusaurus](https://docusaurus.io). The London 0.1.0 approved implementation specification is maintained in london-0.1.0/ and included in the current site build at /london-0.1.0/overview. The product owner has agreed a simpler Move-accounting direction; detailed chapters await coordinated revision. Approval does not imply deployment,.", "source_path": "docs/README.md", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "supporting", "materialized": true, "source_hash": "sha256:aeb6c3b3f3cae284305480445c8d7f602aed0978db372ccc50ac1b3d76a045a9", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_docs_intro_mdx"}) SET n += {"id": "doc_docs_docs_intro_mdx", "type": "document", "label": "Porto Documentation", "description": "--- id: intro title: Porto Docs slug: / sidebarposition: 0 --- Porto Docs Porto is decentralized streaming infrastructure that replaces platform-owned delivery and settlement with a network run by artists, labels, publishers, and independent node operators. This site has two sections, both pulled directly from their source-of-truth repos at build time , nothing here is hand-copied: - [Whitepaper](/whitepaper) , the.", "source_path": "docs/docs/intro.mdx", "source_repository": "docs", "authority": "published_documentation", "classification": "public", "kind": "published", "materialized": true, "source_hash": "sha256:c4bcf9410d7a23dc996d971ca8f4a18800266152e81e61c6740663881e64d1b8", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_00_status_and_scope_md"}) SET n += {"id": "doc_docs_london_0_1_0_00_status_and_scope_md", "type": "document", "label": "London APPROVED: Status, approval and exact scope", "description": "--- id: 00-status-and-scope title: \"Status, approval and exact scope\" sidebarposition: 1 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Approval record The product owner approved this reduced MVP specification on 22 September 2026 in the authoring conversation. This revision replaces the broader London draft introduced by documentation commit fdb5d3f. Approval covers the implementation scope and.", "source_path": "docs/london-0.1.0/00-status-and-scope.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:6fe709416b2b192a5f985532059bbd738b389c728ae6a78190793d073ebe86a9", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_01_executive_architecture_md"}) SET n += {"id": "doc_docs_london_0_1_0_01_executive_architecture_md", "type": "document", "label": "London APPROVED: Executive architecture", "description": "--- id: 01-executive-architecture title: \"Executive architecture\" sidebarposition: 2 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Build the ledger first The [deterministic RocksDB ledger](27-deterministic-rocksdb-ledger.md) is the centre of this architecture and the first implementation milestone. Streaming, accounting and payout state advance through explicit, replayable commands. One Porto owner.", "source_path": "docs/london-0.1.0/01-executive-architecture.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:d0904b1f04b6203c6bb745287bd31d9cd756a10dbcd4735af8940122eebb6d50", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_02_system_architecture_md"}) SET n += {"id": "doc_docs_london_0_1_0_02_system_architecture_md", "type": "document", "label": "London APPROVED: System architecture and ownership", "description": "--- id: 02-system-architecture title: \"System architecture and ownership\" sidebarposition: 3 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Deployment boundaries The web application calls Porto over HTTPS. Porto owns a modular API and job worker codebase, a deterministic RocksDB ledger, private S3 origin in London, and separately permissioned evidence storage. Each participant owns its node host, local.", "source_path": "docs/london-0.1.0/02-system-architecture.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:594ba8d99be830b7e0feab2c6a875e509bb8f64bb52c6106214f719999705473", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_03_roles_and_trust_model_md"}) SET n += {"id": "doc_docs_london_0_1_0_03_roles_and_trust_model_md", "type": "document", "label": "London APPROVED: Roles and trust model", "description": "--- id: 03-roles-and-trust-model title: \"Roles and trust model\" sidebarposition: 4 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Roles Principal Allowed actions Forbidden actions --------- Listener Pay, see own access status, create/close own session, request authorised chunks Supply settlement-critical duration, access other accounts Artist / rights recipient Read own works, allocations, statements and.", "source_path": "docs/london-0.1.0/03-roles-and-trust-model.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:4e1f0a42426e07a26357116ddb1ce9c159c1decaa15d69735c96eba9a58e8556", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_04_listener_and_artist_journeys_md"}) SET n += {"id": "doc_docs_london_0_1_0_04_listener_and_artist_journeys_md", "type": "document", "label": "London APPROVED: Listener, artist and operator journeys", "description": "--- id: 04-listener-and-artist-journeys title: \"Listener, artist and operator journeys\" sidebarposition: 5 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Listener The listener sees a curated catalogue, plan price and billing terms, signs in, and uses hosted checkout. The returning browser shows \u201cConfirming payment\u201d until a verified provider event creates entitlement. A failed or pending payment must not.", "source_path": "docs/london-0.1.0/04-listener-and-artist-journeys.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:a339dc1e5a05334706b78687e0e21fc1820d2fbd3902f1d7d7d8f54ac2c2135d", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_05_catalogue_rights_and_content_md"}) SET n += {"id": "doc_docs_london_0_1_0_05_catalogue_rights_and_content_md", "type": "document", "label": "London APPROVED: Catalogue, rights and content", "description": "--- id: 05-catalogue-rights-and-content title: \"Catalogue, rights and content\" sidebarposition: 6 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Manual catalogue contract An administrator imports a versioned catalogue document with workid, title, display artist, duration in integer milliseconds, licence reference, allowed territories, availability interval, rightsversion, recipients with integer basis.", "source_path": "docs/london-0.1.0/05-catalogue-rights-and-content.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:aad7d3d4afe51391f51d98d744567338456710f0f33b3c3023fdd3e882cf007d", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_06_streaming_delivery_and_attestation_md"}) SET n += {"id": "doc_docs_london_0_1_0_06_streaming_delivery_and_attestation_md", "type": "document", "label": "London APPROVED: Playback, peer delivery and usage evidence", "description": "--- id: 06-streaming-delivery-and-attestation title: \"Playback, peer delivery and usage evidence\" sidebarposition: 7 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Playback authorisation The coordinator checks authenticated entitlement, territory, active work/rights and one active session per listener. A second session request returns 409 ACTIVESESSION; the listener may explicitly close the old session.", "source_path": "docs/london-0.1.0/06-streaming-delivery-and-attestation.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:c089a86590119b5139e110c27fdc40d723d0d1b93577c8c22af6055a3e290c46", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_07_fraud_controls_and_disputes_md"}) SET n += {"id": "doc_docs_london_0_1_0_07_fraud_controls_and_disputes_md", "type": "document", "label": "London APPROVED: Basic integrity controls and manual exceptions", "description": "--- id: 07-fraud-controls-and-disputes title: \"Basic integrity controls and manual exceptions\" sidebarposition: 8 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Small control set This MVP implements deterministic validation, duplicate prevention, rate limits, suspension and manual payout holds. It does not implement a fraud scoring engine, operator reputation market, case-management dashboard,.", "source_path": "docs/london-0.1.0/07-fraud-controls-and-disputes.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:4407f2b7c556fe0da9f7b13fc84ac29508b0f1907fca34b6aebbed7393f4ca2b", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_08_usdc_treasury_and_settlement_md"}) SET n += {"id": "doc_docs_london_0_1_0_08_usdc_treasury_and_settlement_md", "type": "document", "label": "London APPROVED: Funding, accounting and real payouts", "description": "--- id: 08-usdc-treasury-and-settlement title: \"Funding, accounting and real payouts\" sidebarposition: 9 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Money states and ownership GBP subscriptions are Porto company revenue. Listeners purchase access, receive no USDC balance and own no treasury crypto. A selected provider clears payments; Porto converts approved net revenue in batches to native Aptos.", "source_path": "docs/london-0.1.0/08-usdc-treasury-and-settlement.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:fccd1a39a2e1c38743405bd4c17155af4f9e78c90910f3cca6d0ed28937a25ed", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_09_move_contract_specification_md"}) SET n += {"id": "doc_docs_london_0_1_0_09_move_contract_specification_md", "type": "document", "label": "London APPROVED: One append-only commitment contract", "description": "--- id: 09-move-contract-specification title: \"Move-owned accounting and payout protocol\" sidebarposition: 10 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Authority and scope London is an Aptos Move protocol and dapp. The portolondon Move package is the authoritative state machine for funded budgets, accepted aggregate usage, allocation, unpaid obligations and payout completion. The Rust coordinator.", "source_path": "docs/london-0.1.0/09-move-contract-specification.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:15392208f1ed240d505214e7f3d4b96d28f778b5e484d83250bf126543290e9e", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_10_off_chain_services_and_apis_md"}) SET n += {"id": "doc_docs_london_0_1_0_10_off_chain_services_and_apis_md", "type": "document", "label": "London APPROVED: Backend modules, APIs and provider boundaries", "description": "--- id: 10-off-chain-services-and-apis title: \"Backend modules, APIs and provider boundaries\" sidebarposition: 11 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 One backend, restricted jobs Build a modular backend and transactional worker system. The deterministic RocksDB ledger is authoritative for entitlements, grant consumption, evidence decisions, budgets and obligations. One owner executes ordered.", "source_path": "docs/london-0.1.0/10-off-chain-services-and-apis.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:653f36aedc63317b056346563c7c06f8a596a49098b8252fab389ed8c634b344", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_11_data_model_and_event_schemas_md"}) SET n += {"id": "doc_docs_london_0_1_0_11_data_model_and_event_schemas_md", "type": "document", "label": "London APPROVED: Data model, state machines and ledger", "description": "--- id: 11-data-model-and-event-schemas title: \"Data model, state machines and ledger\" sidebarposition: 12 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Authoritative engine The [deterministic RocksDB ledger](27-deterministic-rocksdb-ledger.md) owns all domain mutations. The record catalogue below describes logical entities, not SQL tables. Map entities to the specified column-family/key layout, enforce.", "source_path": "docs/london-0.1.0/11-data-model-and-event-schemas.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:ef683534faf010e4b82a75d6a82e5a2ab883abc2fcfa04d5f444c5e1e964c461", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_12_security_privacy_and_key_management_md"}) SET n += {"id": "doc_docs_london_0_1_0_12_security_privacy_and_key_management_md", "type": "document", "label": "London APPROVED: Security, privacy and key management", "description": "--- id: 12-security-privacy-and-key-management title: \"Security, privacy and key management\" sidebarposition: 13 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Minimum security boundary All internet endpoints require TLS. Browser actions require account ownership and CSRF protection; node API tokens bind one node and cannot authorise finance. The gateway verifies entitlement on grant issuance and.", "source_path": "docs/london-0.1.0/12-security-privacy-and-key-management.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:d9f7f51c6e87749a8f2235b458d4c9f064095a8ea0d66732011f4ef36c3d01f1", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_13_operations_observability_and_incidents_md"}) SET n += {"id": "doc_docs_london_0_1_0_13_operations_observability_and_incidents_md", "type": "document", "label": "London APPROVED: Operations, recovery and incidents", "description": "--- id: 13-operations-observability-and-incidents title: \"Operations, recovery and incidents\" sidebarposition: 14 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Environments Local uses fixture identity/billing, object-storage emulator, local database and Aptos localnet/testnet. Staging uses separate provider sandbox accounts, buckets, keys, database and testnet assets with persistent visible TEST labels..", "source_path": "docs/london-0.1.0/13-operations-observability-and-incidents.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:ab7e673692ef5cf881e1e4a3608ecfddbd937b8862ab2e3ffde6e9233ad79030", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_14_testing_and_launch_gates_md"}) SET n += {"id": "doc_docs_london_0_1_0_14_testing_and_launch_gates_md", "type": "document", "label": "London APPROVED: Testing, proof levels and launch gates", "description": "--- id: 14-testing-and-launch-gates title: \"Testing, proof levels and launch gates\" sidebarposition: 15 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Evidence levels Use SPECIFICATION for these approved requirements; FIXTURE PASS for synthetic tests; STAGING VERIFIED for deployed sandbox behaviour; MAINNET VERIFIED for confirmed real-chain operations; PILOT OBSERVED for actual paid listening and.", "source_path": "docs/london-0.1.0/14-testing-and-launch-gates.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:57b11dce0e5b51d9b1a5938b897021fcd2bc91bedefdaa2fe050f14b627f927e", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_15_migration_to_porto_app_chain_md"}) SET n += {"id": "doc_docs_london_0_1_0_15_migration_to_porto_app_chain_md", "type": "document", "label": "London APPROVED: Future compatibility, no migration implementation", "description": "--- id: 15-migration-to-porto-app-chain title: \"Future compatibility, no migration implementation\" sidebarposition: 16 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Out of scope London does not build a Porto app-chain, bridge, validator stack, token, snapshot-claim contract or migration service. No delivery operator automatically becomes an attestor or validator. These are distinct responsibilities.", "source_path": "docs/london-0.1.0/15-migration-to-porto-app-chain.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:077ec7c9742b0c1ac88a1ee40d6431e051eacaaa82d6308d5e929bc8990268fa", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_16_implementation_plan_md"}) SET n += {"id": "doc_docs_london_0_1_0_16_implementation_plan_md", "type": "document", "label": "London APPROVED: Implementation plan and agent handoff", "description": "--- id: 16-implementation-plan title: \"Implementation plan and agent handoff\" sidebarposition: 17 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Attack this first: W0 and W1 ledger engine Start with [the deterministic RocksDB ledger](27-deterministic-rocksdb-ledger.md). The immediate deliverable is a working pure command executor and single-owner TransactionDB adapter that atomically persist.", "source_path": "docs/london-0.1.0/16-implementation-plan.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:59684a718d4fcf7092bbecbd7cccfb1f2bd5a5aad4957c6aba1165d28a849604", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_17_open_decisions_and_risk_register_md"}) SET n += {"id": "doc_docs_london_0_1_0_17_open_decisions_and_risk_register_md", "type": "document", "label": "London APPROVED: Required launch inputs and residual risks", "description": "--- id: 17-open-decisions-and-risk-register title: \"Required launch inputs and residual risks\" sidebarposition: 18 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Architecture is approved The product owner has approved the reduced scope. There is no open decision about whether to build peer delivery, a separate attestation service or six settlement modules: peer delivery is required, the latter two are.", "source_path": "docs/london-0.1.0/17-open-decisions-and-risk-register.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:e5c846d4259ec33b0b886814a31d15e827c336f9ec93348732e6bbab3e4e04f8", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_18_compatibility_with_existing_pips_md"}) SET n += {"id": "doc_docs_london_0_1_0_18_compatibility_with_existing_pips_md", "type": "document", "label": "London APPROVED: Compatibility with existing Porto sources", "description": "--- id: 18-compatibility-with-existing-pips title: \"Compatibility with existing Porto sources\" sidebarposition: 19 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Status APPROVED FOR LONDON 0.1.0 describes this implementation baseline. CURRENT SOURCE describes the unchanged whitepaper/PIPs, which retain their own status and scope. London does not globally amend those sources. Their historical Beta/Mainnet.", "source_path": "docs/london-0.1.0/18-compatibility-with-existing-pips.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:d051d1a8232c5ce3d96b36045d4bf769d4c51ce6718d8232d81cb65d05dbab28", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_19_architecture_decisions_md"}) SET n += {"id": "doc_docs_london_0_1_0_19_architecture_decisions_md", "type": "document", "label": "London APPROVED: Architecture decision records", "description": "--- id: 19-architecture-decisions title: \"Architecture decision records\" sidebarposition: 20 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Accepted decisions All ADRs below are APPROVED as part of this specification on 22 September 2026. They replace conflicting choices in the earlier London draft. ADR Decision Reason and consequence --------- ADR-01 Aptos Mainnet with native USDC; no PRT or new chain.", "source_path": "docs/london-0.1.0/19-architecture-decisions.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:21146b7cefb8ad159093e40dbfbae80eda9d5a4cd4d1498e0bb1780098de39d1", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_20_api_contracts_md"}) SET n += {"id": "doc_docs_london_0_1_0_20_api_contracts_md", "type": "document", "label": "London APPROVED: API contracts and endpoint catalogue", "description": "--- id: 20-api-contracts title: \"API contracts and endpoint catalogue\" sidebarposition: 21 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Contract authority [OpenAPI](openapi.json) is the exhaustive coordinator and node HTTP surface for this release. It includes closed request/response schemas, examples, authentication, ownership, rate limits, error envelopes, audit-event names and idempotency rules..", "source_path": "docs/london-0.1.0/20-api-contracts.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:f68b21e425247915e6bfa64be34517b130fa209e5be54575ece535c02b4ae5c7", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_21_wire_and_commitment_contracts_md"}) SET n += {"id": "doc_docs_london_0_1_0_21_wire_and_commitment_contracts_md", "type": "document", "label": "London APPROVED: Canonical wire formats, artifacts and verification", "description": "--- id: 21-wire-and-commitment-contracts title: \"Canonical wire formats, artifacts and verification\" sidebarposition: 22 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Primitive encoding Schema identifier is london.v1. Internal IDs are lowercase UUIDv4 strings; all cryptographic hashes are 64 lowercase hexadecimal characters. Aptos addresses are 0x plus 64 lowercase hex digits. Integer wire quantities.", "source_path": "docs/london-0.1.0/21-wire-and-commitment-contracts.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:86f07bc7eac7f2a995f2493c6e3e0abe916e9b4745984b9cfaaa58c3d6257a85", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_22_acceptance_test_catalogue_md"}) SET n += {"id": "doc_docs_london_0_1_0_22_acceptance_test_catalogue_md", "type": "document", "label": "London APPROVED: Acceptance test catalogue", "description": "--- id: 22-acceptance-test-catalogue title: \"Acceptance test catalogue\" sidebarposition: 23 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Execution contract Every case below must have automated coverage where deterministic, or a retained observation/sign-off artifact where it concerns real participants. Record environment, commit/image/profile hashes, input fixtures, observed result, proof level and.", "source_path": "docs/london-0.1.0/22-acceptance-test-catalogue.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:290aea916d42041d18a9ed01aef25ffee7ee05c8b51b33dc47628a13694c427b", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_23_source_register_md"}) SET n += {"id": "doc_docs_london_0_1_0_23_source_register_md", "type": "document", "label": "London APPROVED: Source register and authority", "description": "--- id: 23-source-register title: \"Source register and authority\" sidebarposition: 24 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Current source The pinned [source manifest](source-manifest.json) contains exact SHA-256 hashes and repository revisions for the canonical Porto sources reviewed. Those sources describe existing product/protocol intent, not evidence of this MVP running. Source authority:.", "source_path": "docs/london-0.1.0/23-source-register.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:2b0c67feb66d40a92656d3a849164103b1b1d64b99cddb890ea3c3a77826a982", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_24_validation_and_impact_md"}) SET n += {"id": "doc_docs_london_0_1_0_24_validation_and_impact_md", "type": "document", "label": "London APPROVED: Documentation validation and impact", "description": "--- id: 24-validation-and-impact title: \"Documentation validation and impact\" sidebarposition: 25 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Evidence boundary This report covers specification artifacts and their documentation build. It does not report application implementation, contract deployment, provider integration, actual streaming, real payments or pilot outcomes. All implementation acceptance.", "source_path": "docs/london-0.1.0/24-validation-and-impact.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:c077c45bdad064d036e4aa1e20842fda826390bca2ed45f1572a970797a66a8b", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_25_node_package_and_pilot_md"}) SET n += {"id": "doc_docs_london_0_1_0_25_node_package_and_pilot_md", "type": "document", "label": "London APPROVED: Node package and participation pilot", "description": "--- id: 25-node-package-and-pilot title: \"Node package and participation pilot\" sidebarposition: 26 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Installable node contract Deliver a versioned container image, example configuration, one-command compose startup, healthcheck, upgrade/rollback instructions and uninstall procedure. Target Linux amd64 and arm64 hosts with outbound HTTPS and a public inbound.", "source_path": "docs/london-0.1.0/25-node-package-and-pilot.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:04fe71dfc1e8e95d5175435c13261ca676239c181964076bdd309a2db64aa08a", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
MERGE (n:Node {id: "doc_docs_london_0_1_0_26_configuration_and_release_profile_md"}) SET n += {"id": "doc_docs_london_0_1_0_26_configuration_and_release_profile_md", "type": "document", "label": "London APPROVED: Configuration and release profile", "description": "--- id: 26-configuration-and-release-profile title: \"Configuration and release profile\" sidebarposition: 27 --- APPROVED \u00b7 IMPLEMENTATION SPECIFICATION \u00b7 London 0.1.0 Technical constants These are implementation defaults approved for this bounded MVP, not measured service claims. Changing a constant requires versioned configuration, matching tests and a prospective effective time. Core accounting/replay invariants.", "source_path": "docs/london-0.1.0/26-configuration-and-release-profile.md", "source_repository": "london-implementation", "authority": "approved_implementation_specification", "classification": "public", "kind": "approved_specification", "materialized": true, "source_hash": "sha256:638b6e20416ca4d0f5841a09a222b950ed7905be9f8c878a06fafadf5549d6f4", "source_revision": "d3cf4806e426edc7e75f2b8cd10586d36d1e7a80"};
