      "content": "{\n  \"status\": \"APPROVED\",\n  \"review_date\": \"2026-09-22\",\n  \"sources\": [\n    {\n      \"path\": \"whitepaper/porto-whitepaper.md\",\n      \"sha256\": \"87855bd3352335a843849681e90a30058c95ae68e5fc4181327e6e4ef23c394d\",\n      \"repository_revision\": \"d902041c348b199d1dd2de5ab73de24ff5a26e67\",\n      \"sections\": [\n        \"3.2 System overview\",\n        \"3.3 The revenue split\",\n        \"4.2 Built on a stripped, detached fork of Aptos\",\n        \"6.2 Beta architecture: trusted, region-co-located S3 origin storage\",\n        \"6.3 What counts as a valid, billable play\",\n        \"6.4 From a play to an on-chain record\",\n        \"6.5 From one trusted attestor to a decentralized quorum\",\n        \"7.2 The user-centric model\",\n        \"8. Governance\",\n        \"9. Phased Rollout\"\n      ]\n    },\n    {\n      \"path\": \"pips/PIP-2.md\",\n      \"sha256\": \"8278fcd18b9a6c6a38aff60ca913896e99b2f794d19bf1c2c4e3220251dfc9a7\",\n      \"repository_revision\": \"f7211bb1df96a42be8001f3148df9b5be11c111b\",\n      \"sections\": [\n        \"System overview\",\n        \"Revenue split\",\n        \"Node roles\",\n        \"Phased rollout\"\n      ]\n    },\n    {\n      \"path\": \"pips/PIP-3.md\",\n      \"sha256\": \"6b03d6a1f3c15a09b3eeaae9edf13751c19a2e074cd3f3b53c1e571c2aa5cc94\",\n      \"repository_revision\": \"f7211bb1df96a42be8001f3148df9b5be11c111b\",\n      \"sections\": [\n        \"1. Token identity\",\n        \"2. Issuance: mint-on-subscription\",\n        \"3. Reserve backing (informational, not a peg)\",\n        \"4. Redemption: two-track payout\",\n        \"5. Price oracle requirement\",\n        \"6. Gas / fee model\",\n        \"7. Staking interplay\"\n      ]\n    },\n    {\n      \"path\": \"pips/PIP-4.md\",\n      \"sha256\": \"f8ce0ff3419c4eaa375d5711aecb2607831ad0864637f79f57ca3296a8552121\",\n      \"repository_revision\": \"f7211bb1df96a42be8001f3148df9b5be11c111b\",\n      \"sections\": [\n        \"1. Beta streaming architecture \\u2014 trusted-region, co-located S3 origin\",\n        \"2. Play validity threshold\",\n        \"3. Client heartbeat and session lifecycle\",\n        \"4. On-chain schema\",\n        \"5. Attestation submission and batching\",\n        \"6. Attestation trust model: Beta vs. Mainnet V1\",\n        \"7. Musical work registration\",\n        \"8. Migration path\"\n      ]\n    },\n    {\n      \"path\": \"pips/PIP-5.md\",\n      \"sha256\": \"e73552a699a3fe0dddcccc330497e5a83e4dd8005cdbf8748192006eaf99c621\",\n      \"repository_revision\": \"f7211bb1df96a42be8001f3148df9b5be11c111b\",\n      \"sections\": [\n        \"1. Listener accrual\",\n        \"2. Epoch settlement\",\n        \"3. Multi-party rights-holder splits\",\n        \"4. Interaction with redemption\",\n        \"5. Settlement cost bounding\",\n        \"Security Considerations\"\n      ]\n    },\n    {\n      \"path\": \"pips/PIP-6.md\",\n      \"sha256\": \"c5bb3791ed70a217efa6ef4e40cb36de9ce0f934190bac9c9f0f4dd1f2b287fd\",\n      \"repository_revision\": \"f7211bb1df96a42be8001f3148df9b5be11c111b\",\n      \"sections\": [\n        \"1. Node modes\",\n        \"2. Registration and staking\",\n        \"3. Unbonding\",\n        \"4. Slashing conditions\",\n        \"5. Beta exemption\"\n      ]\n    },\n    {\n      \"path\": \"pips/PIP-7.md\",\n      \"sha256\": \"8f59c0c02258c4e58eab76b6781d16c0700323dfea6baeb686adc81e981e0f04\",\n      \"repository_revision\": \"f7211bb1df96a42be8001f3148df9b5be11c111b\",\n      \"sections\": [\n        \"1. Governed parameter registry\",\n        \"2. Upgrade mechanism\",\n        \"3. Beta: single-key governance\",\n        \"4. Migration path\"\n      ]\n    }\n  ],\n  \"approval_scope\": \"London 0.1.0 implementation specification, not deployment or canonical PIP amendment\"\n}\n"
